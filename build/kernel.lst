   187                              <1> ; -----------------------------------------------------------------------------
   188                              <1> ; draw_clock - format and draw the uptime clock (MM:SS).
   189                              <1> ; -----------------------------------------------------------------------------
   190                              <1> draw_clock:
   191 00002370 60                  <1>     pusha
   192                              <1> 
   193 00002371 A1[89190000]        <1>     mov eax, [tick_count]
   194 00002376 31D2                <1>     xor edx, edx
   195 00002378 BB64000000          <1>     mov ebx, 100                        ; ticks per second
   196 0000237D F7F3                <1>     div ebx                             ; EAX = seconds
   197 0000237F 31D2                <1>     xor edx, edx
   198 00002381 BB3C000000          <1>     mov ebx, 60
   199 00002386 F7F3                <1>     div ebx                             ; EAX = minutes, EDX = seconds
   200 00002388 52                  <1>     push edx                            ; seconds
   201                              <1> 
   202 00002389 BF[A7240000]        <1>     mov edi, clock_buf
   203 0000238E E837000000          <1>     call format_dec2                    ; minutes
   204 00002393 C605[A9240000]3A    <1>     mov byte [clock_buf + 2], ':'
   205 0000239A 58                  <1>     pop eax
   206 0000239B BF[AA240000]        <1>     mov edi, clock_buf + 3
   207 000023A0 E825000000          <1>     call format_dec2                    ; seconds
   208 000023A5 C605[AC240000]00    <1>     mov byte [clock_buf + 5], 0
   209                              <1> 
   210 000023AC A1[DF1B0000]        <1>     mov eax, [gfx_width]
   211 000023B1 83E840              <1>     sub eax, 64                         ; right-align 8 chars
   212 000023B4 BB06000000          <1>     mov ebx, 6
   213 000023B9 BE[A7240000]        <1>     mov esi, clock_buf
   214 000023BE BAE8E8E800          <1>     mov edx, COL_TEXT
   215 000023C3 E845FAFFFF          <1>     call gfx_string
   216                              <1> 
   217 000023C8 61                  <1>     popa
   218 000023C9 C3                  <1>     ret
   219                              <1> 
   220                              <1> ; -----------------------------------------------------------------------------
   221                              <1> ; format_dec2 - EAX = value (0..99), EDI = buffer; writes 2 zero-padded digits.
   222                              <1> ; -----------------------------------------------------------------------------
   223                              <1> format_dec2:
   224 000023CA 50                  <1>     push eax
   225 000023CB 53                  <1>     push ebx
   226 000023CC 52                  <1>     push edx
   227 000023CD 31D2                <1>     xor edx, edx
   228 000023CF BB0A000000          <1>     mov ebx, 10
   229 000023D4 F7F3                <1>     div ebx                             ; EAX = tens, EDX = ones
   230 000023D6 0430                <1>     add al, '0'
   231 000023D8 80C230              <1>     add dl, '0'
   232 000023DB 8807                <1>     mov [edi], al
   233 000023DD 885701              <1>     mov [edi + 1], dl
   234 000023E0 5A                  <1>     pop edx
   235 000023E1 5B                  <1>     pop ebx
   236 000023E2 58                  <1>     pop eax
   237 000023E3 C3                  <1>     ret
   238                              <1> 
