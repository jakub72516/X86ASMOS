   157                                  %include "src/user/demo.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Demo Tasks (Milestone 3)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; A couple of kernel threads that demonstrate pre-emptive round-robin
     5                              <1> ; scheduling and IPC. They are spawned by the kernel's init code.
     6                              <1> ;
     7                              <1> ;   task_worker - arg in EAX = an ASCII character; prints "<ch><counter>"
     8                              <1> ;                 once per second, forever.
     9                              <1> ;   task_ipc    - blocks on ipc_recv and prints each message it receives.
    10                              <1> ; =============================================================================
    11                              <1> 
    12                              <1> ; -----------------------------------------------------------------------------
    13                              <1> ; task_worker - EAX = character to print.
    14                              <1> ; -----------------------------------------------------------------------------
    15                              <1> task_worker:
    16 000024AD 89C3                <1>     mov ebx, eax                        ; EBX = character
    17 000024AF 31F6                <1>     xor esi, esi                        ; ESI = counter
    18                              <1> .loop:
    19 000024B1 88D8                <1>     mov al, bl
    20 000024B3 E88EDEFFFF          <1>     call serial_putchar
    21 000024B8 89F0                <1>     mov eax, esi
    22 000024BA E8BFDEFFFF          <1>     call serial_write_hex
    23 000024BF E8A9DEFFFF          <1>     call serial_newline
    24 000024C4 46                  <1>     inc esi
    25 000024C5 B864000000          <1>     mov eax, 100                        ; sleep ~1 second
    26 000024CA E810F6FFFF          <1>     call task_sleep
    27 000024CF EBE0                <1>     jmp .loop
    28                              <1> 
    29                              <1> ; -----------------------------------------------------------------------------
    30                              <1> ; task_ipc - receive and print IPC messages.
    31                              <1> ; -----------------------------------------------------------------------------
    32                              <1> task_ipc:
    33                              <1> .loop:
    34 000024D1 E8DDF6FFFF          <1>     call ipc_recv
    35 000024D6 83F8FF              <1>     cmp eax, 0xFFFFFFFF
    36 000024D9 7418                <1>     je .sleep
    37 000024DB 89C3                <1>     mov ebx, eax                        ; message value
    38 000024DD BE[FF240000]        <1>     mov esi, msg_ipc_recv
    39 000024E2 E875DEFFFF          <1>     call serial_write
    40 000024E7 89D8                <1>     mov eax, ebx
    41 000024E9 E890DEFFFF          <1>     call serial_write_hex
    42 000024EE E87ADEFFFF          <1>     call serial_newline
    43                              <1> .sleep:
    44 000024F3 B805000000          <1>     mov eax, 5
    45 000024F8 E8E2F5FFFF          <1>     call task_sleep
    46 000024FD EBD2                <1>     jmp .loop
    47                              <1> 
    48 000024FF 49504320726563763D- <1> msg_ipc_recv: db "IPC recv=", 0
    48 00002508 00                  <1>
