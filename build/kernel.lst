   151                                  %include "src/drivers/pit.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Programmable Interval Timer (8253/8254 PIT)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Programs PIT channel 0 in square-wave mode at ~100 Hz to drive the
     5                              <1> ; pre-emptive scheduler. Each tick raises IRQ0, which is remapped to IDT
     6                              <1> ; vector 32.
     7                              <1> ;
     8                              <1> ; Public interface:
     9                              <1> ;   pit_init - program channel 0 and register the timer handler
    10                              <1> ; =============================================================================
    11                              <1> 
    12                              <1> PIT_FREQUENCY equ 100
    13                              <1> PIT_DIVISOR   equ 1193182 / PIT_FREQUENCY
    14                              <1> 
    15                              <1> ; -----------------------------------------------------------------------------
    16                              <1> pit_init:
    17 00001608 50                  <1>     push eax
    18 00001609 52                  <1>     push edx
    19                              <1> 
    20 0000160A 66BA4300            <1>     mov dx, 0x43
    21 0000160E B036                <1>     mov al, 0x36                    ; channel 0, lo/hi byte, mode 3, binary
    22 00001610 EE                  <1>     out dx, al
    23                              <1> 
    24 00001611 66BA4000            <1>     mov dx, 0x40
    25 00001615 66B89B2E            <1>     mov ax, PIT_DIVISOR
    26 00001619 EE                  <1>     out dx, al                      ; divisor low byte
    27 0000161A 88E0                <1>     mov al, ah
    28 0000161C EE                  <1>     out dx, al                      ; divisor high byte
    29                              <1> 
    30 0000161D 5A                  <1>     pop edx
    31 0000161E 58                  <1>     pop eax
    32 0000161F C3                  <1>     ret
   152                                  %include "src/drivers/keyboard.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - PS/2 Keyboard Driver (IRQ1, scancode set 1)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Translates key-down scancodes to ASCII, tracks the shift state, and stores
     5                              <1> ; characters in a 256-byte circular buffer.
     6                              <1> ;
     7                              <1> ; Public interface:
     8                              <1> ;   keyboard_init    - register the IRQ1 handler and unmask it
     9                              <1> ;   keyboard_handler - IRQ1 handler
    10                              <1> ;   keyboard_getc    - EAX = next buffered character (0 if none)
    11                              <1> ; =============================================================================
    12                              <1> 
    13                              <1> KB_BUFFER_SIZE equ 256
    14                              <1> 
    15 00001620 00<rep 100h>        <1> kb_buffer:      times KB_BUFFER_SIZE db 0
    16 00001720 00000000            <1> kb_head:        dd 0
    17 00001724 00000000            <1> kb_tail:        dd 0
    18 00001728 00                  <1> kb_shift:       db 0
    19                              <1> 
    20                              <1> ; -----------------------------------------------------------------------------
    21                              <1> keyboard_init:
    22 00001729 50                  <1>     push eax
    23 0000172A 53                  <1>     push ebx
    24 0000172B B801000000          <1>     mov eax, 1                          ; IRQ1
    25 00001730 BB[47170000]        <1>     mov ebx, keyboard_handler
    26 00001735 E866F1FFFF          <1>     call irq_register
    27 0000173A B801000000          <1>     mov eax, 1
    28 0000173F E8D4EDFFFF          <1>     call pic_unmask
    29 00001744 5B                  <1>     pop ebx
    30 00001745 58                  <1>     pop eax
    31 00001746 C3                  <1>     ret
    32                              <1> 
    33                              <1> ; -----------------------------------------------------------------------------
    34                              <1> ; keyboard_handler - IRQ1.
    35                              <1> ; -----------------------------------------------------------------------------
