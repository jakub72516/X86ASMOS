   144                              <1> 
   145                              <1> ; -----------------------------------------------------------------------------
   146                              <1> ; draw_window - EAX=x, EBX=y, ECX=w, EDX=h, ESI=title string.
   147                              <1> ; -----------------------------------------------------------------------------
   148                              <1> draw_window:
   149 0000230D 50                  <1>     push eax                            ; [esp+16] x
   150 0000230E 53                  <1>     push ebx                            ; [esp+12] y
   151 0000230F 51                  <1>     push ecx                            ; [esp+8]  w
   152 00002310 52                  <1>     push edx                            ; [esp+4]  h
   153 00002311 56                  <1>     push esi                            ; [esp+0]  title
   154                              <1> 
   155                              <1>     ; Window body.
   156 00002312 BE45301E00          <1>     mov esi, COL_WIN_BG
   157 00002317 E8E0F9FFFF          <1>     call gfx_fillrect
   158                              <1> 
   159                              <1>     ; Title bar (height 24).
   160 0000231C 8B442410            <1>     mov eax, [esp+16]
   161 00002320 8B5C240C            <1>     mov ebx, [esp+12]
   162 00002324 8B4C2408            <1>     mov ecx, [esp+8]
   163 00002328 BA18000000          <1>     mov edx, 24
   164 0000232D BE70503A00          <1>     mov esi, COL_WIN_TITLE
   165 00002332 E8C5F9FFFF          <1>     call gfx_fillrect
   166                              <1> 
   167                              <1>     ; Title text.
   168 00002337 8B442410            <1>     mov eax, [esp+16]
   169 0000233B 83C008              <1>     add eax, 8
   170 0000233E 8B5C240C            <1>     mov ebx, [esp+12]
   171 00002342 83C304              <1>     add ebx, 4
   172 00002345 8B3424              <1>     mov esi, [esp+0]
   173 00002348 BAE8E8E800          <1>     mov edx, COL_TEXT
   174 0000234D E8BBFAFFFF          <1>     call gfx_string
   175                              <1> 
   176                              <1>     ; Border.
   177 00002352 8B442410            <1>     mov eax, [esp+16]
   178 00002356 8B5C240C            <1>     mov ebx, [esp+12]
   179 0000235A 8B4C2408            <1>     mov ecx, [esp+8]
   180 0000235E 8B542404            <1>     mov edx, [esp+4]
   181 00002362 BEA0806000          <1>     mov esi, COL_BORDER
   182 00002367 E8D0F9FFFF          <1>     call gfx_rect
   183                              <1> 
   184 0000236C 83C414              <1>     add esp, 20
   185 0000236F C3                  <1>     ret
