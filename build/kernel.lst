     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Kernel Slab Allocator (kmalloc/kfree)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; A classic slab allocator: fixed-size object caches backed by 4 KiB pages
     5                              <1> ; obtained from the PMM. Each page ("slab") carries a small header, and free
     6                              <1> ; objects are threaded through a singly-linked list.
     7                              <1> ;
     8                              <1> ; Cache object sizes: 16, 32, 64, 128, 256, 512, 1024, 2048 bytes.
     9                              <1> ; Allocations larger than 2048 bytes fall back to a whole-page allocator that
    10                              <1> ; stores a small header before the returned pointer.
    11                              <1> ;
    12                              <1> ; Slab header (at the base of every slab page):
    13                              <1> ;   +0  magic       dd 0x42414C53 ("SLAB")
    14                              <1> ;   +4  cache       dd pointer to the owning cache struct
    15                              <1> ;   +8  next        dd next slab in the cache's list
    16                              <1> ;   +12 free_count  dd number of free objects in this slab
    17                              <1> ;   +16 free_head   dd first free object (0 if full)
    18                              <1> ;
    19                              <1> ; Large allocation header (at base of first page):
    20                              <1> ;   +0  magic       dd 0x4752414C ("LARG")
    21                              <1> ;   +4  pages       dd total pages (including header page)
    22                              <1> ;
    23                              <1> ; Public interface:
    24                              <1> ;   kmalloc_init - initialise the cache table
    25                              <1> ;   kmalloc      - EAX = size; returns EAX = pointer (0 on OOM)
    26                              <1> ;   kfree        - EAX = pointer; releases it
    27                              <1> ; =============================================================================
    28                              <1> 
    29                              <1> SLAB_HEADER_SIZE equ 32
    30                              <1> MAGIC_SLAB      equ 0x42414C53
    31                              <1> MAGIC_LARGE     equ 0x4752414C
    32                              <1> 
    33                              <1> NUM_CACHES       equ 8
    34                              <1> CACHE_STRUCT_SIZE equ 16
    35                              <1> 
    36                              <1> CACHE_SIZE       equ 0
    37                              <1> CACHE_SLABS      equ 4
    38                              <1> CACHE_FREE       equ 8
    39                              <1> 
    40                              <1> SLAB_MAGIC       equ 0
    41                              <1> SLAB_CACHE       equ 4
    42                              <1> SLAB_NEXT        equ 8
    43                              <1> SLAB_FREE_COUNT  equ 12
    44                              <1> SLAB_FREE_HEAD   equ 16
    45                              <1> 
