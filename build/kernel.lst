     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Desktop GUI (Milestone 4)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Renders a simple desktop to the back buffer (title bar, two windows, a live
     5                              <1> ; clock, and a status bar) and blits it to the framebuffer. Called from the
     6                              <1> ; boot/idle task at a throttled rate.
     7                              <1> ;
     8                              <1> ; Public interface:
     9                              <1> ;   gui_render - draw the full desktop and blit it
    10                              <1> ; =============================================================================
    11                              <1> 
    12                              <1> COL_BG        equ 0x00162233
    13                              <1> COL_TITLEBAR  equ 0x002B3E55
    14                              <1> COL_WIN_BG    equ 0x001E3045
    15                              <1> COL_WIN_TITLE equ 0x003A5070
    16                              <1> COL_BORDER    equ 0x006080A0
    17                              <1> COL_TEXT      equ 0x00E8E8E8
    18                              <1> COL_ACCENT    equ 0x0028C0A0
    19                              <1> 
    20                              <1> ; -----------------------------------------------------------------------------
    21                              <1> ; gui_render - draw everything and blit.
    22                              <1> ; -----------------------------------------------------------------------------
    23                              <1> gui_render:
    24 0000214A 60                  <1>     pusha
    25                              <1> 
    26                              <1>     ; Desktop background.
    27 0000214B B800000000          <1>     mov eax, 0
    28 00002150 BB00000000          <1>     mov ebx, 0
    29 00002155 8B0D[DF1B0000]      <1>     mov ecx, [gfx_width]
    30 0000215B 8B15[E31B0000]      <1>     mov edx, [gfx_height]
    31 00002161 BE33221600          <1>     mov esi, COL_BG
    32 00002166 E891FBFFFF          <1>     call gfx_fillrect
    33                              <1> 
    34                              <1>     ; Title bar.
    35 0000216B B800000000          <1>     mov eax, 0
    36 00002170 BB00000000          <1>     mov ebx, 0
    37 00002175 8B0D[DF1B0000]      <1>     mov ecx, [gfx_width]
    38 0000217B BA1C000000          <1>     mov edx, 28
    39 00002180 BE553E2B00          <1>     mov esi, COL_TITLEBAR
    40 00002185 E872FBFFFF          <1>     call gfx_fillrect
    41                              <1> 
    42 0000218A B80C000000          <1>     mov eax, 12
    43 0000218F BB06000000          <1>     mov ebx, 6
    44 00002194 BE[E4230000]        <1>     mov esi, msg_title
    45 00002199 BAE8E8E800          <1>     mov edx, COL_TEXT
    46 0000219E E86AFCFFFF          <1>     call gfx_string
    47                              <1> 
    48 000021A3 E8C8010000          <1>     call draw_clock
    49                              <1> 
    50                              <1>     ; Window 1: Terminal.
    51 000021A8 B818000000          <1>     mov eax, 24
    52 000021AD BB3C000000          <1>     mov ebx, 60
    53 000021B2 B9CC010000          <1>     mov ecx, 460
    54 000021B7 BAF0000000          <1>     mov edx, 240
    55 000021BC BE[ED230000]        <1>     mov esi, msg_win_term
    56 000021C1 E847010000          <1>     call draw_window
    57 000021C6 B828000000          <1>     mov eax, 40
    58 000021CB BB6C000000          <1>     mov ebx, 108
    59 000021D0 BE[FD230000]        <1>     mov esi, msg_term1
    60 000021D5 BAE8E8E800          <1>     mov edx, COL_TEXT
    61 000021DA E82EFCFFFF          <1>     call gfx_string
    62 000021DF B828000000          <1>     mov eax, 40
    63 000021E4 BB84000000          <1>     mov ebx, 132
    64 000021E9 BE[10240000]        <1>     mov esi, msg_term2
    65 000021EE BAE8E8E800          <1>     mov edx, COL_TEXT
    66 000021F3 E815FCFFFF          <1>     call gfx_string
    67 000021F8 B828000000          <1>     mov eax, 40
    68 000021FD BB9C000000          <1>     mov ebx, 156
    69 00002202 BE[28240000]        <1>     mov esi, msg_term3
    70 00002207 BAA0C02800          <1>     mov edx, COL_ACCENT
    71 0000220C E8FCFBFFFF          <1>     call gfx_string
    72                              <1> 
    73                              <1>     ; Window 2: System info.
    74 00002211 B8F4010000          <1>     mov eax, 500
    75 00002216 BB3C000000          <1>     mov ebx, 60
    76 0000221B B914010000          <1>     mov ecx, 276
    77 00002220 BAC8000000          <1>     mov edx, 200
    78 00002225 BE[F6230000]        <1>     mov esi, msg_win_sys
    79 0000222A E8DE000000          <1>     call draw_window
    80 0000222F B804020000          <1>     mov eax, 516
    81 00002234 BB6C000000          <1>     mov ebx, 108
    82 00002239 BE[3C240000]        <1>     mov esi, msg_sys1
    83 0000223E BAE8E8E800          <1>     mov edx, COL_TEXT
    84 00002243 E8C5FBFFFF          <1>     call gfx_string
    85 00002248 B804020000          <1>     mov eax, 516
    86 0000224D BB84000000          <1>     mov ebx, 132
    87 00002252 BE[54240000]        <1>     mov esi, msg_sys2
    88 00002257 BAE8E8E800          <1>     mov edx, COL_TEXT
    89 0000225C E8ACFBFFFF          <1>     call gfx_string
    90 00002261 B804020000          <1>     mov eax, 516
    91 00002266 BB9C000000          <1>     mov ebx, 156
    92 0000226B BE[6A240000]        <1>     mov esi, msg_sys3
    93 00002270 BAE8E8E800          <1>     mov edx, COL_TEXT
    94 00002275 E893FBFFFF          <1>     call gfx_string
    95                              <1> 
    96                              <1>     ; Status bar.
    97 0000227A B800000000          <1>     mov eax, 0
    98 0000227F 8B1D[E31B0000]      <1>     mov ebx, [gfx_height]
    99 00002285 83EB18              <1>     sub ebx, 24
   100 00002288 8B0D[DF1B0000]      <1>     mov ecx, [gfx_width]
   101 0000228E BA18000000          <1>     mov edx, 24
   102 00002293 BE553E2B00          <1>     mov esi, COL_TITLEBAR
   103 00002298 E85FFAFFFF          <1>     call gfx_fillrect
   104                              <1> 
   105 0000229D B80C000000          <1>     mov eax, 12
   106 000022A2 8B1D[E31B0000]      <1>     mov ebx, [gfx_height]
   107 000022A8 83EB12              <1>     sub ebx, 18
   108 000022AB BE[81240000]        <1>     mov esi, msg_status
   109 000022B0 BAE8E8E800          <1>     mov edx, COL_TEXT
   110 000022B5 E853FBFFFF          <1>     call gfx_string
   111                              <1> 
