   118                              <1> ; -----------------------------------------------------------------------------
   119                              <1> ; draw_cursor - draw a small cross cursor at the mouse position.
   120                              <1> ; -----------------------------------------------------------------------------
   121                              <1> draw_cursor:
   122 000022C6 60                  <1>     pusha
   123                              <1> 
   124                              <1>     ; Horizontal bar.
   125 000022C7 A1[64180000]        <1>     mov eax, [mouse_x]
   126 000022CC 83E804              <1>     sub eax, 4
   127 000022CF 8B1D[68180000]      <1>     mov ebx, [mouse_y]
   128 000022D5 B909000000          <1>     mov ecx, 9
   129 000022DA BA01000000          <1>     mov edx, 1
   130 000022DF BEA0C02800          <1>     mov esi, COL_ACCENT
   131 000022E4 E813FAFFFF          <1>     call gfx_fillrect
   132                              <1> 
   133                              <1>     ; Vertical bar.
   134 000022E9 A1[64180000]        <1>     mov eax, [mouse_x]
   135 000022EE 8B1D[68180000]      <1>     mov ebx, [mouse_y]
   136 000022F4 83EB04              <1>     sub ebx, 4
   137 000022F7 B901000000          <1>     mov ecx, 1
   138 000022FC BA09000000          <1>     mov edx, 9
   139 00002301 BEA0C02800          <1>     mov esi, COL_ACCENT
   140 00002306 E8F1F9FFFF          <1>     call gfx_fillrect
