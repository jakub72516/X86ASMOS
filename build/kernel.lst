   118                              <1> ; idt_install
   119                              <1> ; -----------------------------------------------------------------------------
   120                              <1> idt_install:
   121 000007C4 60                  <1>     pusha
   122 000007C5 31C9                <1>     xor ecx, ecx
   123                              <1> .set:
   124 000007C7 89C8                <1>     mov eax, ecx
   125 000007C9 8B1C8D[04070000]    <1>     mov ebx, [isr_table + ecx * 4]
   126 000007D0 51                  <1>     push ecx
   127 000007D1 B18E                <1>     mov cl, 0x8E                    ; ring 0 interrupt gate
   128 000007D3 E832000000          <1>     call idt_set_gate
   129 000007D8 59                  <1>     pop ecx
   130 000007D9 41                  <1>     inc ecx
   131 000007DA 83F930              <1>     cmp ecx, 48
   132 000007DD 72E8                <1>     jb .set
   133                              <1> 
   134                              <1>     ; Syscall gate (ring 3 accessible).
   135 000007DF B880000000          <1>     mov eax, 0x80
   136 000007E4 BB[EC060000]        <1>     mov ebx, isr_syscall
   137 000007E9 B1EE                <1>     mov cl, 0xEE
   138 000007EB E81A000000          <1>     call idt_set_gate
   139                              <1> 
   140                              <1>     ; Yield gate (ring 3 accessible).
   141 000007F0 B881000000          <1>     mov eax, 0x81
   142 000007F5 BB[F8060000]        <1>     mov ebx, isr_yield
   143 000007FA B1EE                <1>     mov cl, 0xEE
   144 000007FC E809000000          <1>     call idt_set_gate
   145                              <1> 
   146 00000801 0F011D[70110000]    <1>     lidt [idt_ptr]
   147 00000808 61                  <1>     popa
   148 00000809 C3                  <1>     ret
   149                              <1> 
   150                              <1> ; -----------------------------------------------------------------------------
   151                              <1> ; idt_set_gate - EAX=vector, EBX=handler address, CL=attributes byte.
   152                              <1> ; -----------------------------------------------------------------------------
   153                              <1> idt_set_gate:
   154 0000080A 57                  <1>     push edi
   155 0000080B 52                  <1>     push edx
   156 0000080C BF[70090000]        <1>     mov edi, idt
   157 00000811 89C2                <1>     mov edx, eax
   158 00000813 C1E203              <1>     shl edx, 3                      ; vector * 8
   159 00000816 01D7                <1>     add edi, edx
   160 00000818 66891F              <1>     mov word [edi], bx              ; handler offset bits 0-15
   161 0000081B 66C747020800        <1>     mov word [edi + 2], KERNEL_CS   ; code selector
   162 00000821 C6470400            <1>     mov byte [edi + 4], 0           ; IST
   163 00000825 884F05              <1>     mov byte [edi + 5], cl          ; attributes
   164 00000828 C1EB10              <1>     shr ebx, 16
   165 0000082B 66895F06            <1>     mov word [edi + 6], bx          ; handler offset bits 16-31
   166 0000082F 5A                  <1>     pop edx
   167 00000830 5F                  <1>     pop edi
   168 00000831 C3                  <1>     ret
   169                              <1> 
   170                              <1> ; -----------------------------------------------------------------------------
   171                              <1> ; isr_common - the funnel for every interrupt.
   172                              <1> ; -----------------------------------------------------------------------------
   173                              <1> isr_common:
   174 00000832 60                  <1>     pusha
   175 00000833 1E                  <1>     push ds
   176 00000834 06                  <1>     push es
   177 00000835 0FA0                <1>     push fs
   178 00000837 0FA8                <1>     push gs
   179 00000839 66B81000            <1>     mov ax, KERNEL_DS
   180 0000083D 8ED8                <1>     mov ds, ax
   181 0000083F 8EC0                <1>     mov es, ax
   182 00000841 8EE0                <1>     mov fs, ax
   183 00000843 8EE8                <1>     mov gs, ax
   184                              <1> 
   185 00000845 89E6                <1>     mov esi, esp                    ; ESI = frame pointer
   186 00000847 8B4630              <1>     mov eax, [esi + REG_INTNUM]
   187                              <1> 
   188 0000084A 3D80000000          <1>     cmp eax, 0x80
   189 0000084F 7418                <1>     je .syscall
   190 00000851 3D81000000          <1>     cmp eax, 0x81
   191 00000856 740C                <1>     je .yield
   192 00000858 83F820              <1>     cmp eax, 32
   193 0000085B 7213                <1>     jb .exception
   194 0000085D E81E000000          <1>     call irq_dispatch
   195 00000862 EB11                <1>     jmp .epilogue
   196                              <1> 
   197                              <1> .yield:
   198 00000864 E9B6120000          <1>     jmp yield_handler                ; tail jump: ESP stays at the frame base
   199                              <1> 
   200                              <1> .syscall:
   201 00000869 E8A3000000          <1>     call syscall_handler
   202 0000086E EB05                <1>     jmp .epilogue
   203                              <1> 
   204                              <1> .exception:
   205 00000870 E833000000          <1>     call exception_handler
   206                              <1> 
   207                              <1> .epilogue:
   208                              <1> isr_restore:
   209 00000875 0FA9                <1>     pop gs
   210 00000877 0FA1                <1>     pop fs
   211 00000879 07                  <1>     pop es
   212 0000087A 1F                  <1>     pop ds
   213 0000087B 61                  <1>     popa
   214 0000087C 83C408              <1>     add esp, 8                      ; drop int number + error code
   215 0000087F CF                  <1>     iret
   216                              <1> 
   217                              <1> ; -----------------------------------------------------------------------------
   218                              <1> ; irq_dispatch - ESI = frame. Runs a registered handler (if any) then EOI.
   219                              <1> ; -----------------------------------------------------------------------------
   220                              <1> irq_dispatch:
   221 00000880 8B4630              <1>     mov eax, [esi + REG_INTNUM]
   222 00000883 83E820              <1>     sub eax, 32                     ; EAX = IRQ number
   223 00000886 50                  <1>     push eax
   224 00000887 83F80F              <1>     cmp eax, 15
   225 0000088A 770D                <1>     ja .send_eoi
   226 0000088C 8B1485[30090000]    <1>     mov edx, [irq_handlers + eax * 4]
   227 00000893 85D2                <1>     test edx, edx
   228 00000895 7402                <1>     jz .send_eoi
   229 00000897 FFD2                <1>     call edx                        ; handler(EAX=irq, ESI=frame)
   230                              <1> .send_eoi:
   231 00000899 58                  <1>     pop eax
   232 0000089A E844FCFFFF          <1>     call pic_send_eoi
   233 0000089F C3                  <1>     ret
   234                              <1> 
   235                              <1> ; -----------------------------------------------------------------------------
   236                              <1> ; irq_register - EAX=irq, EBX=handler address.
   237                              <1> ; -----------------------------------------------------------------------------
   238                              <1> irq_register:
   239 000008A0 891C85[30090000]    <1>     mov [irq_handlers + eax * 4], ebx
   240 000008A7 C3                  <1>     ret
   241                              <1> 
   242                              <1> ; -----------------------------------------------------------------------------
   243                              <1> ; exception_handler - ESI = frame. Prints a diagnostic and halts.
   244                              <1> ; -----------------------------------------------------------------------------
   245                              <1> exception_handler:
   246 000008A8 89F7                <1>     mov edi, esi                    ; EDI = frame (ESI is reused for strings)
   247                              <1> 
   248 000008AA BE[12090000]        <1>     mov esi, msg_exc
   249 000008AF E8DCF9FFFF          <1>     call vga_print
   250 000008B4 E8A3FAFFFF          <1>     call serial_write
   251                              <1> 
   252 000008B9 8B4730              <1>     mov eax, [edi + REG_INTNUM]
   253 000008BC E8DEF9FFFF          <1>     call vga_print_hex
   254 000008C1 E8B8FAFFFF          <1>     call serial_write_hex
   255                              <1> 
   256 000008C6 BE[17090000]        <1>     mov esi, msg_exc_err
