   206                              <1> ; -----------------------------------------------------------------------------
   207                              <1> ; timer_handler - IRQ0. EOI, advance the tick, then context switch.
   208                              <1> ; Entered via `call` from irq_dispatch, so the stack has a return chain we
   209                              <1> ; skip with `add esp, 12` to reach the frame base.
   210                              <1> ; -----------------------------------------------------------------------------
   211                              <1> timer_handler:
   212 00001B10 B020                <1>     mov al, 0x20
   213 00001B12 E620                <1>     out 0x20, al                        ; EOI to master PIC (IRQ0)
   214                              <1> 
   215 00001B14 FF05[89190000]      <1>     inc dword [tick_count]
   216                              <1> 
   217 00001B1A 83C40C              <1>     add esp, 12                         ; skip return chain -> frame base
   218 00001B1D EB02                <1>     jmp schedule_switch
   219                              <1> 
   220                              <1> ; -----------------------------------------------------------------------------
   221                              <1> ; yield_handler - int 0x81. Entered via `jmp` from isr_common, so ESP already
   222                              <1> ; points at the frame base.
   223                              <1> ; -----------------------------------------------------------------------------
   224                              <1> yield_handler:
   225 00001B1F EB00                <1>     jmp schedule_switch
   226                              <1> 
   227                              <1> ; -----------------------------------------------------------------------------
   228                              <1> ; schedule_switch - ESP must point at the frame base. Saves the current task,
   229                              <1> ; selects the next READY task (waking sleepers whose time is due), and jumps
   230                              <1> ; into isr_restore to resume it.
   231                              <1> ; -----------------------------------------------------------------------------
   232                              <1> schedule_switch:
   233 00001B21 A1[85190000]        <1>     mov eax, [current_task]
   234 00001B26 8920                <1>     mov [eax + TCB_ESP], esp            ; save current frame base
   235                              <1> 
   236 00001B28 8B4004              <1>     mov eax, [eax + TCB_NEXT]           ; start from the next TCB
   237                              <1> .find_next:
   238 00001B2B 83780800            <1>     cmp dword [eax + TCB_STATE], TASK_STATE_READY
   239 00001B2F 7428                <1>     je .found
   240 00001B31 83780801            <1>     cmp dword [eax + TCB_STATE], TASK_STATE_SLEEPING
   241 00001B35 751D                <1>     jne .skip                           ; zombie or other -> skip
   242 00001B37 8B500C              <1>     mov edx, [eax + TCB_SLEEP]
   243 00001B3A 8B0D[89190000]      <1>     mov ecx, [tick_count]
   244 00001B40 39CA                <1>     cmp edx, ecx
   245 00001B42 7710                <1>     ja .skip                            ; still sleeping
   246 00001B44 C7400800000000      <1>     mov dword [eax + TCB_STATE], TASK_STATE_READY   ; wake it
   247 00001B4B C7400C00000000      <1>     mov dword [eax + TCB_SLEEP], 0
   248 00001B52 EB05                <1>     jmp .found
   249                              <1> .skip:
   250 00001B54 8B4004              <1>     mov eax, [eax + TCB_NEXT]
   251 00001B57 EBD2                <1>     jmp .find_next
   252                              <1> .found:
   253 00001B59 A3[85190000]        <1>     mov [current_task], eax
   254 00001B5E 8B20                <1>     mov esp, [eax + TCB_ESP]            ; load the new task's frame base
   255 00001B60 E910EDFFFF          <1>     jmp isr_restore
   256                              <1> 
   257                              <1> ; -----------------------------------------------------------------------------
   258                              <1> ; IPC: single-word mailbox per task.
   259                              <1> ;   ipc_send - EAX=pid, EBX=message word; returns EAX=0 success, 1 if no task.
   260                              <1> ;   ipc_recv - returns EAX=message word, or 0xFFFFFFFF if the queue is empty.
   261                              <1> ; -----------------------------------------------------------------------------
   262                              <1> ipc_send:
   263 00001B65 53                  <1>     push ebx
   264 00001B66 51                  <1>     push ecx
   265 00001B67 52                  <1>     push edx
   266 00001B68 56                  <1>     push esi
   267 00001B69 57                  <1>     push edi
   268                              <1> 
   269                              <1>     ; Locate the destination TCB by pid.
   270 00001B6A 8B0D[85190000]      <1>     mov ecx, [current_task]
   271 00001B70 89CA                <1>     mov edx, ecx                        ; start of circular scan
   272                              <1> .scan:
   273 00001B72 394110              <1>     cmp [ecx + TCB_PID], eax
   274 00001B75 740E                <1>     je .found_dest
   275 00001B77 8B4904              <1>     mov ecx, [ecx + TCB_NEXT]
   276 00001B7A 39D1                <1>     cmp ecx, edx
   277 00001B7C 75F4                <1>     jne .scan
   278 00001B7E B801000000          <1>     mov eax, 1                          ; destination not found
   279 00001B83 EB28                <1>     jmp .done
   280                              <1> 
   281                              <1> .found_dest:
   282                              <1>     ; Allocate a mailbox node (16 bytes via kmalloc 16-byte slab).
   283 00001B85 50                  <1>     push eax                            ; pid
   284 00001B86 53                  <1>     push ebx                            ; message
   285 00001B87 B810000000          <1>     mov eax, 16
   286 00001B8C E81AF9FFFF          <1>     call kmalloc
   287 00001B91 89C7                <1>     mov edi, eax
   288 00001B93 5B                  <1>     pop ebx
   289 00001B94 58                  <1>     pop eax
   290 00001B95 85FF                <1>     test edi, edi
   291 00001B97 740F                <1>     jz .fail_alloc
   292                              <1> 
   293 00001B99 891F                <1>     mov [edi + 0], ebx                  ; message value
   294 00001B9B 8B5918              <1>     mov ebx, [ecx + TCB_MSG_HEAD]
   295 00001B9E 895F04              <1>     mov [edi + 4], ebx                  ; link to previous head
   296 00001BA1 897918              <1>     mov [ecx + TCB_MSG_HEAD], edi       ; new head
   297 00001BA4 31C0                <1>     xor eax, eax                        ; success
   298 00001BA6 EB05                <1>     jmp .done
   299                              <1> 
   300                              <1> .fail_alloc:
   301 00001BA8 B802000000          <1>     mov eax, 2
   302                              <1> .done:
   303 00001BAD 5F                  <1>     pop edi
   304 00001BAE 5E                  <1>     pop esi
   305 00001BAF 5A                  <1>     pop edx
   306 00001BB0 59                  <1>     pop ecx
   307 00001BB1 5B                  <1>     pop ebx
   308 00001BB2 C3                  <1>     ret
   309                              <1> 
   310                              <1> ; -----------------------------------------------------------------------------
   311                              <1> ; ipc_recv - returns EAX = next message (0xFFFFFFFF if empty).
   312                              <1> ; -----------------------------------------------------------------------------
   313                              <1> ipc_recv:
   314 00001BB3 53                  <1>     push ebx
   315 00001BB4 51                  <1>     push ecx
   316                              <1> 
   317 00001BB5 8B0D[85190000]      <1>     mov ecx, [current_task]
   318 00001BBB 8B4118              <1>     mov eax, [ecx + TCB_MSG_HEAD]
   319 00001BBE 85C0                <1>     test eax, eax
   320 00001BC0 7415                <1>     jz .empty
   321                              <1> 
   322                              <1>     ; Pop the head node.
   323 00001BC2 8B5804              <1>     mov ebx, [eax + 4]                  ; next node
   324 00001BC5 895918              <1>     mov [ecx + TCB_MSG_HEAD], ebx
   325 00001BC8 8B08                <1>     mov ecx, [eax + 0]                  ; message value
   326 00001BCA 51                  <1>     push ecx
   327 00001BCB 50                  <1>     push eax
   328                              <1>     ; Free the node.
   329 00001BCC E8E5F9FFFF          <1>     call kfree
   330 00001BD1 58                  <1>     pop eax
   331 00001BD2 59                  <1>     pop ecx
   332 00001BD3 89C8                <1>     mov eax, ecx                        ; return message value
   333 00001BD5 EB05                <1>     jmp .done
   334                              <1> 
   335                              <1> .empty:
   336 00001BD7 B8FFFFFFFF          <1>     mov eax, 0xFFFFFFFF
   337                              <1> .done:
   338 00001BDC 59                  <1>     pop ecx
   339 00001BDD 5B                  <1>     pop ebx
   340 00001BDE C3                  <1>     ret
   155                                  %include "src/gui/gfx.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Graphics Driver (VBE 32bpp, double-buffered)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Reads the video mode the bootloader selected (VBE linear framebuffer),
     5                              <1> ; identity-maps the framebuffer into the page tables, and provides a
     6                              <1> ; double-buffered drawing surface plus an 8x8 bitmap font.
     7                              <1> ;
     8                              <1> ; All drawing goes to a back buffer (allocated from the heap); gfx_blit copies
     9                              <1> ; it to the real framebuffer in one shot, avoiding flicker/tearing.
    10                              <1> ;
    11                              <1> ; Colours are 0x00RRGGBB. Coordinates are (x, y) with origin at top-left.
    12                              <1> ;
    13                              <1> ; Public interface:
    14                              <1> ;   gfx_init       - read mode, map framebuffer, allocate back buffer
    15                              <1> ;   gfx_clear      - EAX = colour; fill the back buffer
    16                              <1> ;   gfx_pixel      - EAX=x, EBX=y, ECX=colour
    17                              <1> ;   gfx_fillrect   - EAX=x, EBX=y, ECX=w, EDX=h, ESI=colour
    18                              <1> ;   gfx_rect       - EAX=x, EBX=y, ECX=w, EDX=h, ESI=colour (outline)
    19                              <1> ;   gfx_char       - EAX=x, EBX=y, ECX=char, EDX=colour (8x8 font)
    20                              <1> ;   gfx_string     - EAX=x, EBX=y, ESI=string, EDX=colour
    21                              <1> ;   gfx_blit       - copy back buffer to framebuffer
    22                              <1> ; =============================================================================
    23                              <1> 
    24                              <1> ; Boot info video offsets (match stage2).
    25                              <1> BOOT_VIDEO_OFF equ 0x610
    26                              <1> VIDEO_W_OFF    equ 0
    27                              <1> VIDEO_H_OFF    equ 2
    28                              <1> VIDEO_BPP_OFF  equ 4
    29                              <1> VIDEO_PITCH_OFF equ 5
    30                              <1> VIDEO_FB_OFF   equ 7
    31                              <1> 
    32                              <1> ; Globals
    33 00001BDF 00000000            <1> gfx_width:      dd 0
    34 00001BE3 00000000            <1> gfx_height:     dd 0
    35 00001BE7 00000000            <1> gfx_bpp:        dd 0
    36 00001BEB 00000000            <1> gfx_pitch:      dd 0
    37 00001BEF 00000000            <1> gfx_fb:         dd 0        ; framebuffer address (virtual)
    38 00001BF3 00000000            <1> gfx_back:       dd 0        ; back buffer address
    39 00001BF7 00000000            <1> gfx_fb_size:    dd 0        ; framebuffer size in bytes
    40                              <1> 
    41                              <1> ; -----------------------------------------------------------------------------
    42                              <1> gfx_init:
    43 00001BFB 60                  <1>     pusha
    44                              <1> 
    45 00001BFC 8B35[36010000]      <1>     mov esi, [boot_info_ptr]
    46 00001C02 81C610060000        <1>     add esi, BOOT_VIDEO_OFF
    47                              <1> 
    48 00001C08 0FB706              <1>     movzx eax, word [esi + VIDEO_W_OFF]
    49 00001C0B A3[DF1B0000]        <1>     mov [gfx_width], eax
    50 00001C10 0FB74602            <1>     movzx eax, word [esi + VIDEO_H_OFF]
    51 00001C14 A3[E31B0000]        <1>     mov [gfx_height], eax
    52 00001C19 0FB64604            <1>     movzx eax, byte [esi + VIDEO_BPP_OFF]
    53 00001C1D A3[E71B0000]        <1>     mov [gfx_bpp], eax
    54 00001C22 0FB74605            <1>     movzx eax, word [esi + VIDEO_PITCH_OFF]
    55 00001C26 A3[EB1B0000]        <1>     mov [gfx_pitch], eax
    56 00001C2B 8B4607              <1>     mov eax, [esi + VIDEO_FB_OFF]
    57 00001C2E A3[EF1B0000]        <1>     mov [gfx_fb], eax
    58                              <1> 
    59                              <1>     ; No video mode? Stay in text mode.
    60 00001C33 833D[DF1B0000]00    <1>     cmp dword [gfx_width], 0
    61 00001C3A 7471                <1>     je .no_video
    62                              <1> 
    63                              <1>     ; Compute framebuffer size and identity-map it (it usually lives far
    64                              <1>     ; above the 128 MiB identity map, e.g. 0xFD000000 in QEMU).
    65 00001C3C A1[EB1B0000]        <1>     mov eax, [gfx_pitch]
    66 00001C41 0FAF05[E31B0000]    <1>     imul eax, [gfx_height]
    67 00001C48 A3[F71B0000]        <1>     mov [gfx_fb_size], eax
    68                              <1> 
    69 00001C4D 8B1D[EF1B0000]      <1>     mov ebx, [gfx_fb]
    70 00001C53 8B0D[EF1B0000]      <1>     mov ecx, [gfx_fb]
    71 00001C59 8B35[F71B0000]      <1>     mov esi, [gfx_fb_size]
    72 00001C5F 81C6FF0F0000        <1>     add esi, 4095
    73 00001C65 C1EE0C              <1>     shr esi, 12                         ; page count (rounded up)
    74                              <1> .map_loop:
    75 00001C68 53                  <1>     push ebx
    76 00001C69 51                  <1>     push ecx
    77 00001C6A 56                  <1>     push esi
    78 00001C6B BA03000000          <1>     mov edx, PTE_PRESENT | PTE_WRITABLE
    79 00001C70 B800002000          <1>     mov eax, PAGE_DIR
    80 00001C75 E8BEF6FFFF          <1>     call map_page
    81 00001C7A 5E                  <1>     pop esi
    82 00001C7B 59                  <1>     pop ecx
    83 00001C7C 5B                  <1>     pop ebx
    84 00001C7D 81C300100000        <1>     add ebx, 4096
    85 00001C83 81C100100000        <1>     add ecx, 4096
    86 00001C89 4E                  <1>     dec esi
    87 00001C8A 75DC                <1>     jnz .map_loop
    88                              <1> 
    89                              <1>     ; Flush the TLB.
    90 00001C8C B800002000          <1>     mov eax, PAGE_DIR
    91 00001C91 0F22D8              <1>     mov cr3, eax
    92                              <1> 
    93                              <1>     ; Allocate the back buffer.
    94 00001C94 A1[F71B0000]        <1>     mov eax, [gfx_fb_size]
    95 00001C99 E80DF8FFFF          <1>     call kmalloc
    96 00001C9E A3[F31B0000]        <1>     mov [gfx_back], eax
    97                              <1> 
    98 00001CA3 B800000000          <1>     mov eax, 0x00000000
    99 00001CA8 E802000000          <1>     call gfx_clear
   100                              <1> 
   101                              <1> .no_video:
   102 00001CAD 61                  <1>     popa
   103 00001CAE C3                  <1>     ret
   104                              <1> 
   105                              <1> ; -----------------------------------------------------------------------------
   106                              <1> ; gfx_clear - EAX = colour.
   107                              <1> ; -----------------------------------------------------------------------------
   108                              <1> gfx_clear:
   109 00001CAF 57                  <1>     push edi
   110 00001CB0 51                  <1>     push ecx
   111 00001CB1 8B3D[F31B0000]      <1>     mov edi, [gfx_back]
   112 00001CB7 8B0D[F71B0000]      <1>     mov ecx, [gfx_fb_size]
   113 00001CBD C1E902              <1>     shr ecx, 2
   114 00001CC0 F3AB                <1>     rep stosd
   115 00001CC2 59                  <1>     pop ecx
   116 00001CC3 5F                  <1>     pop edi
   117 00001CC4 C3                  <1>     ret
   118                              <1> 
   119                              <1> ; -----------------------------------------------------------------------------
   120                              <1> ; gfx_pixel - EAX=x, EBX=y, ECX=colour. Clips to bounds.
   121                              <1> ; -----------------------------------------------------------------------------
   122                              <1> gfx_pixel:
   123 00001CC5 57                  <1>     push edi
   124 00001CC6 52                  <1>     push edx
   125 00001CC7 3B05[DF1B0000]      <1>     cmp eax, [gfx_width]
   126 00001CCD 732A                <1>     jae .done
   127 00001CCF 3B1D[E31B0000]      <1>     cmp ebx, [gfx_height]
   128 00001CD5 7322                <1>     jae .done
   129 00001CD7 85C0                <1>     test eax, eax
   130 00001CD9 781E                <1>     js .done
   131 00001CDB 85DB                <1>     test ebx, ebx
   132 00001CDD 781A                <1>     js .done
   133 00001CDF 89DA                <1>     mov edx, ebx
   134 00001CE1 0FAF15[EB1B0000]    <1>     imul edx, [gfx_pitch]
   135 00001CE8 8D3C8500000000      <1>     lea edi, [eax * 4]
   136 00001CEF 01FA                <1>     add edx, edi
   137 00001CF1 0315[F31B0000]      <1>     add edx, [gfx_back]
   138 00001CF7 890A                <1>     mov [edx], ecx
   139                              <1> .done:
   140 00001CF9 5A                  <1>     pop edx
   141 00001CFA 5F                  <1>     pop edi
   142 00001CFB C3                  <1>     ret
   143                              <1> 
   144                              <1> ; -----------------------------------------------------------------------------
   145                              <1> ; gfx_fillrect - EAX=x, EBX=y, ECX=w, EDX=h, ESI=colour. Caller must pass
   146                              <1> ; coordinates within the framebuffer bounds.
   147                              <1> ; -----------------------------------------------------------------------------
   148                              <1> gfx_fillrect:
   149 00001CFC 53                  <1>     push ebx
   150 00001CFD 51                  <1>     push ecx
   151 00001CFE 52                  <1>     push edx
   152 00001CFF 56                  <1>     push esi
   153 00001D00 57                  <1>     push edi
   154 00001D01 55                  <1>     push ebp
   155                              <1> 
   156 00001D02 8B2D[F31B0000]      <1>     mov ebp, [gfx_back]
   157 00001D08 89DF                <1>     mov edi, ebx                        ; y
   158 00001D0A 0FAF3D[EB1B0000]    <1>     imul edi, [gfx_pitch]
   159 00001D11 01FD                <1>     add ebp, edi
   160 00001D13 8D3C8500000000      <1>     lea edi, [eax * 4]                  ; x * 4
   161 00001D1A 01FD                <1>     add ebp, edi                        ; EBP = top-left pixel address
   162                              <1> 
   163 00001D1C 89D7                <1>     mov edi, edx                        ; EDI = rows remaining
   164 00001D1E 89F0                <1>     mov eax, esi                        ; EAX = colour
   165                              <1> 
