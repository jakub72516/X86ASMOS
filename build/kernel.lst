   148                                  %include "src/kernel/pmm.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Physical Memory Manager (PMM)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Tracks physical 4 KiB frames with a bitmap. Bit set (1) = frame in use,
     5                              <1> ; bit clear (0) = frame free. The bitmap lives at PMM_BITMAP and covers
     6                              <1> ; MAX_PHYS_MEM bytes (128 MiB by default).
     7                              <1> ;
     8                              <1> ; The kernel reserves everything below RESERVED_KERNEL_MEM (4 MiB) for its own
     9                              <1> ; code, paging structures, and the bitmap itself. Everything above that is
    10                              <1> ; handed out by pmm_alloc_frame.
    11                              <1> ;
    12                              <1> ; Public interface:
    13                              <1> ;   pmm_init          - parse the boot info E820 map and populate the bitmap
    14                              <1> ;   pmm_alloc_frame   - EAX = physical address of a free frame (0 if OOM)
    15                              <1> ;   pmm_free_frame    - EAX = physical address of the frame to release
    16                              <1> ;   pmm_used_frames   - EAX = number of frames currently allocated
    17                              <1> ;   pmm_total_frames  - EAX = number of usable frames
    18                              <1> ; =============================================================================
    19                              <1> 
    20                              <1> MAX_PHYS_MEM        equ 128 * 1024 * 1024      ; 128 MiB
    21                              <1> PAGE_SIZE           equ 4096
    22                              <1> MAX_FRAMES          equ MAX_PHYS_MEM / PAGE_SIZE
    23                              <1> RESERVED_KERNEL_MEM equ 4 * 1024 * 1024        ; 4 MiB reserved for the kernel
    24                              <1> PMM_BITMAP          equ 0x280000
    25                              <1> 
    26                              <1> E820_USABLE        equ 1
    27                              <1> 
    28 00001176 00000000            <1> pmm_total:      dd 0        ; usable frame count
    29 0000117A 00000000            <1> pmm_allocated:  dd 0        ; currently allocated count
    30                              <1> 
    31                              <1> ; -----------------------------------------------------------------------------
    32                              <1> ; pmm_init - ESI = boot info block pointer. Builds the free list from E820.
    33                              <1> ; -----------------------------------------------------------------------------
    34                              <1> pmm_init:
    35 0000117E 60                  <1>     pusha
    36                              <1> 
    37                              <1>     ; Zero the bitmap (all frames initially marked used).
    38 0000117F BF00002800          <1>     mov edi, PMM_BITMAP
    39 00001184 B900040000          <1>     mov ecx, (MAX_FRAMES + 7) / 8 / 4
    40 00001189 B8FFFFFFFF          <1>     mov eax, 0xFFFFFFFF
    41 0000118E F3AB                <1>     rep stosd
    42                              <1> 
    43 00001190 C705[76110000]0000- <1>     mov dword [pmm_total], 0
    43 00001198 0000                <1>
    44 0000119A C705[7A110000]0000- <1>     mov dword [pmm_allocated], 0
    44 000011A2 0000                <1>
    45                              <1> 
    46                              <1>     ; Iterate E820 entries, freeing usable regions that lie within our
    47                              <1>     ; supported physical range.
    48 000011A4 8B4E04              <1>     mov ecx, [esi + 4]                  ; entry count
    49 000011A7 89F7                <1>     mov edi, esi
    50 000011A9 83C708              <1>     add edi, 8                          ; first entry
    51 000011AC 85C9                <1>     test ecx, ecx
    52 000011AE 745B                <1>     jz .done
    53                              <1> 
    54                              <1> .next_entry:
    55 000011B0 837F1001            <1>     cmp dword [edi + 16], E820_USABLE
    56 000011B4 754F                <1>     jne .skip
    57                              <1> 
    58                              <1>     ; base = [edi] (low) / [edi+4] (high); length = [edi+8]/[edi+12].
    59 000011B6 837F0400            <1>     cmp dword [edi + 4], 0              ; base high must be 0 (< 4 GiB)
    60 000011BA 7549                <1>     jne .skip
    61 000011BC 8B07                <1>     mov eax, [edi]                      ; base
    62 000011BE 8B5F08              <1>     mov ebx, [edi + 8]                  ; length low
    63                              <1> 
    64                              <1>     ; Clamp to MAX_PHYS_MEM.
    65 000011C1 3D00000008          <1>     cmp eax, MAX_PHYS_MEM
    66 000011C6 733D                <1>     jae .skip
    67                              <1>     ; end = base + length, clamp to MAX_PHYS_MEM
    68 000011C8 89C2                <1>     mov edx, eax
    69 000011CA 01DA                <1>     add edx, ebx
    70 000011CC 7208                <1>     jc .clamp
    71 000011CE 81FA00000008        <1>     cmp edx, MAX_PHYS_MEM
    72 000011D4 7605                <1>     jbe .have_end
    73                              <1> .clamp:
    74 000011D6 BA00000008          <1>     mov edx, MAX_PHYS_MEM
    75                              <1> .have_end:
    76                              <1>     ; Frame-align base up, end down.
    77 000011DB 05FF0F0000          <1>     add eax, PAGE_SIZE - 1
    78 000011E0 2500F0FFFF          <1>     and eax, ~(PAGE_SIZE - 1)
    79 000011E5 81E200F0FFFF        <1>     and edx, ~(PAGE_SIZE - 1)
    80 000011EB 39D0                <1>     cmp eax, edx
    81 000011ED 7316                <1>     jae .skip
    82                              <1> 
    83                              <1>     ; Free frames [base, end).
    84                              <1> .free_loop:
    85 000011EF 50                  <1>     push eax
    86 000011F0 E89C000000          <1>     call _pmm_set_free
    87 000011F5 58                  <1>     pop eax
    88 000011F6 FF05[76110000]      <1>     inc dword [pmm_total]
    89 000011FC 0500100000          <1>     add eax, PAGE_SIZE
    90 00001201 39D0                <1>     cmp eax, edx
    91 00001203 72EA                <1>     jb .free_loop
    92                              <1> 
    93                              <1> .skip:
    94 00001205 83C718              <1>     add edi, 24
    95 00001208 49                  <1>     dec ecx
    96 00001209 75A5                <1>     jnz .next_entry
    97                              <1> 
    98                              <1> .done:
    99                              <1>     ; Reserve everything below RESERVED_KERNEL_MEM for the kernel.
   100 0000120B B900040000          <1>     mov ecx, RESERVED_KERNEL_MEM / PAGE_SIZE
   101 00001210 31C0                <1>     xor eax, eax
   102                              <1> .reserve_loop:
   103 00001212 50                  <1>     push eax
   104 00001213 51                  <1>     push ecx
   105 00001214 E89A000000          <1>     call _pmm_set_used
   106 00001219 59                  <1>     pop ecx
   107 0000121A 58                  <1>     pop eax
   108 0000121B FF05[7A110000]      <1>     inc dword [pmm_allocated]
   109 00001221 0500100000          <1>     add eax, PAGE_SIZE
   110 00001226 E2EA                <1>     loop .reserve_loop
   111                              <1> 
   112 00001228 61                  <1>     popa
   113 00001229 C3                  <1>     ret
   114                              <1> 
   115                              <1> ; -----------------------------------------------------------------------------
   116                              <1> ; pmm_alloc_frame - returns EAX = frame address (0 on out of memory).
   117                              <1> ; -----------------------------------------------------------------------------
   118                              <1> pmm_alloc_frame:
   119 0000122A 53                  <1>     push ebx
   120 0000122B 51                  <1>     push ecx
   121 0000122C 52                  <1>     push edx
   122 0000122D 57                  <1>     push edi
   123 0000122E 56                  <1>     push esi
   124                              <1> 
   125 0000122F BF00002800          <1>     mov edi, PMM_BITMAP
   126 00001234 31C9                <1>     xor ecx, ecx                        ; byte index
   127                              <1> 
   128                              <1> .scan:
   129 00001236 81F900100000        <1>     cmp ecx, (MAX_FRAMES + 7) / 8
   130 0000123C 733D                <1>     jae .oom
   131 0000123E 0FB6040F            <1>     movzx eax, byte [edi + ecx]
   132 00001242 3CFF                <1>     cmp al, 0xFF                        ; any free bit in this byte?
   133 00001244 7432                <1>     je .next_byte
   134                              <1> 
   135 00001246 F7D0                <1>     not eax                             ; 1 = free
   136 00001248 0FBCD8              <1>     bsf ebx, eax                        ; EBX = bit index (0-7)
   137                              <1> 
   138                              <1>     ; frame index = ecx*8 + ebx
   139 0000124B 89CA                <1>     mov edx, ecx
   140 0000124D C1E203              <1>     shl edx, 3
   141 00001250 01DA                <1>     add edx, ebx                        ; EDX = frame index
   142                              <1> 
   143                              <1>     ; Mark it used: byte = frame>>3, bit = frame&7.
   144 00001252 89D0                <1>     mov eax, edx
   145 00001254 C1E803              <1>     shr eax, 3                          ; byte index
   146 00001257 89D6                <1>     mov esi, edx
   147 00001259 83E607              <1>     and esi, 7                          ; bit offset
   148 0000125C 89F1                <1>     mov ecx, esi
   149 0000125E BB01000000          <1>     mov ebx, 1
   150 00001263 D3E3                <1>     shl ebx, cl                         ; EBX = 1 << bit
   151 00001265 089800002800        <1>     or byte [PMM_BITMAP + eax], bl
   152                              <1> 
   153 0000126B FF05[7A110000]      <1>     inc dword [pmm_allocated]
   154                              <1> 
   155                              <1>     ; Address = frame index * 4096.
   156 00001271 89D0                <1>     mov eax, edx
   157 00001273 C1E00C              <1>     shl eax, 12
   158                              <1> 
   159 00001276 EB05                <1>     jmp .done
   160                              <1> 
   161                              <1> .next_byte:
   162 00001278 41                  <1>     inc ecx
   163 00001279 EBBB                <1>     jmp .scan
   164                              <1> 
   165                              <1> .oom:
   166 0000127B 31C0                <1>     xor eax, eax
   167                              <1> .done:
   168 0000127D 5E                  <1>     pop esi
   169 0000127E 5F                  <1>     pop edi
   170 0000127F 5A                  <1>     pop edx
   171 00001280 59                  <1>     pop ecx
   172 00001281 5B                  <1>     pop ebx
   173 00001282 C3                  <1>     ret
   174                              <1> 
   175                              <1> ; -----------------------------------------------------------------------------
   176                              <1> ; pmm_free_frame - EAX = frame address to release.
   177                              <1> ; -----------------------------------------------------------------------------
   178                              <1> pmm_free_frame:
   179 00001283 50                  <1>     push eax
   180 00001284 E808000000          <1>     call _pmm_set_free
   181 00001289 58                  <1>     pop eax
   182 0000128A FF0D[7A110000]      <1>     dec dword [pmm_allocated]
   183 00001290 C3                  <1>     ret
   184                              <1> 
   185                              <1> ; --- internal helpers (do not preserve registers) ---------------------------
   186                              <1> 
   187                              <1> ; _pmm_set_free - EAX = frame address; clears its bitmap bit.
   188                              <1> _pmm_set_free:
   189 00001291 50                  <1>     push eax
   190 00001292 51                  <1>     push ecx
   191 00001293 52                  <1>     push edx
   192 00001294 89C2                <1>     mov edx, eax
   193 00001296 C1EA0C              <1>     shr edx, 12                         ; frame index
   194 00001299 89D0                <1>     mov eax, edx
   195 0000129B 89D1                <1>     mov ecx, edx
   196 0000129D C1E803              <1>     shr eax, 3
   197 000012A0 83E107              <1>     and ecx, 7
   198 000012A3 B201                <1>     mov dl, 1
   199 000012A5 D2E2                <1>     shl dl, cl
   200 000012A7 F6D2                <1>     not dl
   201 000012A9 209000002800        <1>     and byte [PMM_BITMAP + eax], dl
   202 000012AF 5A                  <1>     pop edx
   203 000012B0 59                  <1>     pop ecx
   204 000012B1 58                  <1>     pop eax
   205 000012B2 C3                  <1>     ret
   206                              <1> 
   207                              <1> ; _pmm_set_used - EAX = frame address; sets its bitmap bit.
   208                              <1> _pmm_set_used:
   209 000012B3 51                  <1>     push ecx
   210 000012B4 52                  <1>     push edx
   211 000012B5 89C2                <1>     mov edx, eax
   212 000012B7 C1EA0C              <1>     shr edx, 12
   213 000012BA 89D0                <1>     mov eax, edx
   214 000012BC 89D1                <1>     mov ecx, edx
   215 000012BE C1E803              <1>     shr eax, 3
   216 000012C1 83E107              <1>     and ecx, 7
   217 000012C4 B201                <1>     mov dl, 1
   218 000012C6 D2E2                <1>     shl dl, cl
   219 000012C8 089000002800        <1>     or byte [PMM_BITMAP + eax], dl
   220 000012CE 5A                  <1>     pop edx
   221 000012CF 59                  <1>     pop ecx
   222 000012D0 C3                  <1>     ret
   223                              <1> 
   224                              <1> ; -----------------------------------------------------------------------------
   225                              <1> pmm_used_frames:
   226 000012D1 A1[7A110000]        <1>     mov eax, [pmm_allocated]
   227 000012D6 C3                  <1>     ret
   228                              <1> 
   229                              <1> pmm_total_frames:
   230 000012D7 A1[76110000]        <1>     mov eax, [pmm_total]
   231 000012DC C3                  <1>     ret
   149                                  %include "src/kernel/paging.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Paging
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Sets up 4 KiB paging with a flat identity map over the supported physical
     5                              <1> ; range so that virtual addresses equal physical addresses for kernel and DMA
     6                              <1> ; work. Later subsystems (user mode, demand paging, JIT code) reuse map_page
     7                              <1> ; and unmap_page.
     8                              <1> ;
     9                              <1> ; Page structures live at fixed low addresses (below the 4 MiB reservation):
    10                              <1> ;   PAGE_DIR     0x200000   page directory (1024 PDEs)
    11                              <1> ;   PAGE_TABLES  0x201000   page tables for the identity map
    12                              <1> ;
    13                              <1> ; Page table flag bits:
    14                              <1> ;   PTE_PRESENT   1
    15                              <1> ;   PTE_WRITABLE  2
    16                              <1> ;   PTE_USER      4        (ring-3 accessible)
    17                              <1> ;
    18                              <1> ; Public interface:
    19                              <1> ;   paging_init    - identity-map IDENTITY_MAP_MB and enable paging
    20                              <1> ;   map_page       - EAX=pde base, EBX=virt, ECX=phys, EDX=flags
    21                              <1> ;   unmap_page     - EAX=pde base, EBX=virt
    22                              <1> ; =============================================================================
    23                              <1> 
    24                              <1> PAGE_DIR        equ 0x200000
    25                              <1> PAGE_TABLES     equ 0x201000
    26                              <1> IDENTITY_MAP_MB equ 128
    27                              <1> 
    28                              <1> PTE_PRESENT     equ 1
    29                              <1> PTE_WRITABLE    equ 2
    30                              <1> PTE_USER        equ 4
    31                              <1> 
    32                              <1> ; -----------------------------------------------------------------------------
    33                              <1> ; paging_init - build the identity map and turn paging on.
    34                              <1> ; -----------------------------------------------------------------------------
    35                              <1> paging_init:
    36 000012DD 60                  <1>     pusha
    37                              <1> 
    38 000012DE BF00002000          <1>     mov edi, PAGE_DIR
    39 000012E3 B900040000          <1>     mov ecx, 1024
    40 000012E8 31C0                <1>     xor eax, eax
    41 000012EA F3AB                <1>     rep stosd                          ; zero page directory
    42                              <1> 
    43 000012EC BF00102000          <1>     mov edi, PAGE_TABLES
    44 000012F1 31F6                <1>     xor esi, esi                       ; physical address to map
    45 000012F3 B900800000          <1>     mov ecx, IDENTITY_MAP_MB * 256     ; pages = MB * 256
    46                              <1> .ptes:
    47 000012F8 89F0                <1>     mov eax, esi
    48 000012FA 83C803              <1>     or eax, PTE_PRESENT | PTE_WRITABLE
    49 000012FD AB                  <1>     stosd
    50 000012FE 81C600100000        <1>     add esi, 4096
    51 00001304 E2F2                <1>     loop .ptes
    52                              <1> 
    53 00001306 BF00002000          <1>     mov edi, PAGE_DIR
    54 0000130B BE00102000          <1>     mov esi, PAGE_TABLES
    55 00001310 B920000000          <1>     mov ecx, IDENTITY_MAP_MB / 4       ; 4 MiB per PDE
    56                              <1> .pdes:
    57 00001315 89F0                <1>     mov eax, esi
    58 00001317 83C803              <1>     or eax, PTE_PRESENT | PTE_WRITABLE
    59 0000131A AB                  <1>     stosd
    60 0000131B 81C600100000        <1>     add esi, 4096
    61 00001321 E2F2                <1>     loop .pdes
    62                              <1> 
    63 00001323 B800002000          <1>     mov eax, PAGE_DIR
    64 00001328 0F22D8              <1>     mov cr3, eax
    65 0000132B 0F20C0              <1>     mov eax, cr0
    66 0000132E 0D00000080          <1>     or eax, 0x80000000
    67 00001333 0F22C0              <1>     mov cr0, eax
    68                              <1> 
    69 00001336 61                  <1>     popa
    70 00001337 C3                  <1>     ret
    71                              <1> 
    72                              <1> ; -----------------------------------------------------------------------------
    73                              <1> ; map_page - map one 4 KiB page (allocating a page table if necessary).
    74                              <1> ;   EAX = page directory base (physical)
    75                              <1> ;   EBX = virtual address
    76                              <1> ;   ECX = physical address (4 KiB aligned)
    77                              <1> ;   EDX = flags (PTE_*)
    78                              <1> ; Returns EAX = 0 on success, 1 on out-of-memory.
    79                              <1> ; -----------------------------------------------------------------------------
    80                              <1> map_page:
    81 00001338 53                  <1>     push ebx
    82 00001339 51                  <1>     push ecx
    83 0000133A 52                  <1>     push edx
    84 0000133B 56                  <1>     push esi
    85 0000133C 57                  <1>     push edi
    86 0000133D 55                  <1>     push ebp
    87                              <1> 
    88 0000133E 89C5                <1>     mov ebp, eax                       ; EBP = page directory base
    89 00001340 89DE                <1>     mov esi, ebx
    90 00001342 C1EE16              <1>     shr esi, 22                        ; ESI = PDE index
    91 00001345 89DF                <1>     mov edi, ebx
    92 00001347 C1EF0C              <1>     shr edi, 12
    93 0000134A 81E7FF030000        <1>     and edi, 0x3FF                     ; EDI = PTE index
    94                              <1> 
    95 00001350 8B44B500            <1>     mov eax, [ebp + esi * 4]           ; EAX = PDE
    96 00001354 A901000000          <1>     test eax, PTE_PRESENT
    97 00001359 7526                <1>     jnz .have_table
    98                              <1> 
    99                              <1>     ; No page table yet: allocate + zero a physical frame for it.
   100 0000135B E8CAFEFFFF          <1>     call pmm_alloc_frame
   101 00001360 85C0                <1>     test eax, eax
   102 00001362 742F                <1>     jz .fail
   103                              <1> 
   104 00001364 50                  <1>     push eax                           ; save table frame
   105 00001365 51                  <1>     push ecx
   106 00001366 89C7                <1>     mov edi, eax
   107 00001368 B900040000          <1>     mov ecx, 1024
   108 0000136D 31C0                <1>     xor eax, eax
   109 0000136F F3AB                <1>     rep stosd
   110 00001371 59                  <1>     pop ecx
   111 00001372 58                  <1>     pop eax                            ; EAX = table frame
   112                              <1> 
   113 00001373 83C807              <1>     or eax, PTE_PRESENT | PTE_WRITABLE | PTE_USER
   114 00001376 8944B500            <1>     mov [ebp + esi * 4], eax           ; link PDE
   115 0000137A 2500F0FFFF          <1>     and eax, ~0xFFF                    ; EAX = table base
   116 0000137F EB05                <1>     jmp .write_pte
   117                              <1> 
   118                              <1> .have_table:
   119 00001381 2500F0FFFF          <1>     and eax, ~0xFFF                    ; EAX = table base
   120                              <1> 
   121                              <1> .write_pte:
   122 00001386 89CA                <1>     mov edx, ecx                       ; EDX = physical address
   123 00001388 0B54240C            <1>     or edx, [esp + 12]                 ; OR in the original flags (pushed EDX)
   124 0000138C 8914B8              <1>     mov [eax + edi * 4], edx
   125 0000138F 31C0                <1>     xor eax, eax                       ; success
   126 00001391 EB05                <1>     jmp .done
   127                              <1> 
   128                              <1> .fail:
   129 00001393 B801000000          <1>     mov eax, 1                         ; out of memory
   130                              <1> .done:
   131 00001398 5D                  <1>     pop ebp
   132 00001399 5F                  <1>     pop edi
   133 0000139A 5E                  <1>     pop esi
   134 0000139B 5A                  <1>     pop edx
   135 0000139C 59                  <1>     pop ecx
   136 0000139D 5B                  <1>     pop ebx
