     1                                  ; =============================================================================
     2                                  ; X86ASMOS - Kernel Entry Point
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; Entry state (from Stage 2 loader):
     5                                  ;   ESI = linear address of the boot information block (0x5000)
     6                                  ;   DL  = BIOS boot drive number
     7                                  ;   Segments: flat ring-0 data; CS = 0x08
     8                                  ;   Interrupts disabled, paging not yet enabled
     9                                  ;
    10                                  ; This file is assembled as a flat binary linked to 0x100000 and includes the
    11                                  ; other kernel modules (via %include) to form a single image.
    12                                  ; =============================================================================
    13                                  
    14                                  BITS 32
    15                                  ORG 0x100000
    16                                  
    17                                  ; --- Memory layout ----------------------------------------------------------
    18                                  KERNEL_STACK_TOP equ 0x90000         ; top of the kernel/boot-task stack
    19                                  
    20                                  section .text
    21                                  
    22                                  global _start
    23                                  _start:
    24 00000000 BC00000900                  mov esp, KERNEL_STACK_TOP
    25                                  
    26 00000005 8935[36010000]              mov [boot_info_ptr], esi
    27 0000000B 8815[3A010000]              mov [boot_drive], dl
    28                                  
    29 00000011 E8FA020000                  call serial_init
    30 00000016 E889010000                  call vga_init
    31                                  
    32 0000001B BE[4B010000]                mov esi, msg_banner
    33 00000020 E86B020000                  call vga_print
    34 00000025 E832030000                  call serial_write
    35                                  
    36                                      ; Validate the boot information block.
    37 0000002A 8B35[36010000]              mov esi, [boot_info_ptr]
    38 00000030 813E534F5341                cmp dword [esi], 0x41534F53
    39 00000036 0F85E7000000                jne .bad_bootinfo
    40                                  
    41                                      ; --- Memory manager, GDT/IDT, interrupts --------------------------------
    42 0000003C E865030000                  call gdt_install
    43                                  
    44 00000041 8B35[36010000]              mov esi, [boot_info_ptr]
    45 00000047 E832110000                  call pmm_init
    46                                  
    47 0000004C E88C120000                  call paging_init
    48                                  
    49 00000051 E822140000                  call kmalloc_init
    50                                  
    51 00000056 E8A01B0000                  call gfx_init                       ; graphics (needs paging + heap)
    52                                  
    53 0000005B E846040000                  call pic_remap
    54 00000060 E85F070000                  call idt_install
    55                                  
    56                                      ; --- Scheduler + timer ---------------------------------------------------
    57 00000065 E827190000                  call scheduler_init
    58                                  
    59 0000006A E899150000                  call pit_init
    60                                  
    61 0000006F B800000000                  mov eax, 0                          ; IRQ0
    62 00000074 BB[101B0000]                mov ebx, timer_handler
    63 00000079 E822080000                  call irq_register
    64                                  
    65 0000007E B800000000                  mov eax, 0                          ; unmask the timer IRQ
    66 00000083 E890040000                  call pic_unmask
    67                                  
    68                                      ; --- Input devices --------------------------------------------------------
    69 00000088 E89C160000                  call keyboard_init
    70 0000008D E8E2170000                  call mouse_init
    71                                  
    72                                      ; --- Spawn demo tasks -----------------------------------------------------
    73 00000092 BB[AD240000]                mov ebx, task_worker
    74 00000097 B941000000                  mov ecx, 'A'
    75 0000009C E844190000                  call task_create
    76                                  
    77 000000A1 BB[AD240000]                mov ebx, task_worker
    78 000000A6 B942000000                  mov ecx, 'B'
    79 000000AB E835190000                  call task_create
    80                                  
    81 000000B0 BB[D1240000]                mov ebx, task_ipc
    82 000000B5 31C9                        xor ecx, ecx
    83 000000B7 E829190000                  call task_create
    84 000000BC A3[3B010000]                mov [ipc_pid], eax                  ; remember the IPC task's pid
    85                                  
    86 000000C1 BE[74010000]                mov esi, msg_ready
    87 000000C6 E8C5010000                  call vga_print
    88 000000CB E88C020000                  call serial_write
    89                                  
    90 000000D0 FB                          sti
    91                                  
    92                                      ; --- Boot task becomes the idle/GUI/IPC-producer loop. It never sleeps,
    93                                      ; so the run queue always has at least one ready task. -------------------
    94                                  .idle:
    95                                      ; Redraw the desktop at ~10 Hz.
    96 000000D1 A1[89190000]                mov eax, [tick_count]
    97 000000D6 2B05[47010000]              sub eax, [last_render_tick]
    98 000000DC 83F80A                      cmp eax, 10
    99 000000DF 720F                        jb .no_render
   100 000000E1 A1[89190000]                mov eax, [tick_count]
   101 000000E6 A3[47010000]                mov [last_render_tick], eax
   102 000000EB E85A200000                  call gui_render
   103                                  .no_render:
   104                                  
   105                                      ; Send an IPC message every 50 ticks.
   106 000000F0 A1[89190000]                mov eax, [tick_count]
   107 000000F5 2B05[43010000]              sub eax, [last_ipc_tick]
   108 000000FB 83F832                      cmp eax, 50
   109 000000FE 7220                        jb .no_ipc
   110 00000100 A1[89190000]                mov eax, [tick_count]
   111 00000105 A3[43010000]                mov [last_ipc_tick], eax
   112 0000010A FF05[3F010000]              inc dword [idle_counter]
   113 00000110 A1[3B010000]                mov eax, [ipc_pid]
   114 00000115 8B1D[3F010000]              mov ebx, [idle_counter]
   115 0000011B E8451A0000                  call ipc_send                       ; send a counter message to the IPC task
   116                                  .no_ipc:
   117 00000120 F4                          hlt
   118 00000121 EBAE                        jmp .idle
   119                                  
   120                                  .bad_bootinfo:
   121 00000123 BE[87010000]                mov esi, msg_badinfo
   122 00000128 E863010000                  call vga_print
   123 0000012D E82A020000                  call serial_write
   124 00000132 FA                          cli
   125 00000133 F4                          hlt
   126 00000134 EBED                        jmp .bad_bootinfo
   127                                  
   128                                  ; --- Data ------------------------------------------------------------------
   129 00000136 00000000                boot_info_ptr:  dd 0
   130 0000013A 00                      boot_drive:     db 0
   131 0000013B 00000000                ipc_pid:        dd 0
   132 0000013F 00000000                idle_counter:   dd 0
   133 00000143 00000000                last_ipc_tick:  dd 0
   134 00000147 00000000                last_render_tick: dd 0
   135                                  
   136 0000014B 58383641534D4F5320-     msg_banner:     db "X86ASMOS 32-bit kernel (protected mode)", 0x0A, 0
   136 00000154 33322D626974206B65-
   136 0000015D 726E656C202870726F-
   136 00000166 746563746564206D6F-
   136 0000016F 6465290A00         
   137 00000174 7363686564756C6572-     msg_ready:      db "scheduler running", 0x0A, 0
   137 0000017D 2072756E6E696E670A-
   137 00000186 00                 
   138 00000187 4552524F523A206261-     msg_badinfo:    db "ERROR: bad boot info magic", 0
   138 00000190 6420626F6F7420696E-
   138 00000199 666F206D6167696300 
   139                                  
   140                                  ; -----------------------------------------------------------------------------
   141                                  ; Include the rest of the kernel modules.
   142                                  ; -----------------------------------------------------------------------------
   143                                  %include "src/kernel/vga.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - VGA Text Mode Driver
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Provides early-boot console output through the 80x25 text-mode framebuffer
     5                              <1> ; at 0xB8000. All routines preserve all registers they do not document.
     6                              <1> ;
     7                              <1> ; Public interface:
     8                              <1> ;   vga_init          - clear screen, home cursor
     9                              <1> ;   vga_clear         - clear screen, home cursor
    10                              <1> ;   vga_putchar       - AL = character (interprets '\n', '\r', '\t')
    11                              <1> ;   vga_print         - ESI = NUL-terminated string
    12                              <1> ;   vga_print_hex     - EAX = value, prints 8 hex digits
    13                              <1> ;   vga_newline       - CR + LF
    14                              <1> ;   vga_set_cursor    - DH = row, DL = col
    15                              <1> ; =============================================================================
    16                              <1> 
    17                              <1> VGA_ADDR        equ 0xB8000
    18                              <1> VGA_WIDTH       equ 80
    19                              <1> VGA_HEIGHT      equ 25
    20                              <1> VGA_ATTR        equ 0x0F        ; white on black
    21                              <1> 
    22                              <1> ; Cursor state.
    23 000001A2 00                  <1> vga_row:        db 0
    24 000001A3 00                  <1> vga_col:        db 0
    25                              <1> 
    26                              <1> ; -----------------------------------------------------------------------------
    27                              <1> vga_init:
    28 000001A4 E801000000          <1>     call vga_clear
    29 000001A9 C3                  <1>     ret
    30                              <1> 
    31                              <1> ; -----------------------------------------------------------------------------
    32                              <1> vga_clear:
    33 000001AA 60                  <1>     pusha
    34 000001AB BF00800B00          <1>     mov edi, VGA_ADDR
    35 000001B0 66B8200F            <1>     mov ax, (VGA_ATTR << 8) | ' '
    36 000001B4 B9D0070000          <1>     mov ecx, VGA_WIDTH * VGA_HEIGHT
    37 000001B9 66F3AB              <1>     rep stosw
    38 000001BC C605[A2010000]00    <1>     mov byte [vga_row], 0
    39 000001C3 C605[A3010000]00    <1>     mov byte [vga_col], 0
    40 000001CA E808010000          <1>     call vga_update_cursor
    41 000001CF 61                  <1>     popa
    42 000001D0 C3                  <1>     ret
    43                              <1> 
    44                              <1> ; -----------------------------------------------------------------------------
    45                              <1> ; vga_putchar - write one character in AL at the cursor, advancing it.
    46                              <1> ; -----------------------------------------------------------------------------
    47                              <1> vga_putchar:
    48 000001D1 3C0A                <1>     cmp al, 0x0A
    49 000001D3 7470                <1>     je vga_newline
    50 000001D5 3C0D                <1>     cmp al, 0x0D
    51 000001D7 740C                <1>     je .carriage_return
    52 000001D9 3C09                <1>     cmp al, 0x09
    53 000001DB 7415                <1>     je .tab
    54                              <1>     ; fall through to store a printable character
    55 000001DD 50                  <1>     push eax
    56 000001DE E823000000          <1>     call .store
    57 000001E3 58                  <1>     pop eax
    58 000001E4 C3                  <1>     ret
    59                              <1> .carriage_return:
    60 000001E5 C605[A3010000]00    <1>     mov byte [vga_col], 0
    61 000001EC E8E6000000          <1>     call vga_update_cursor
    62 000001F1 C3                  <1>     ret
    63                              <1> .tab:
    64 000001F2 A0[A3010000]        <1>     mov al, [vga_col]
    65 000001F7 0408                <1>     add al, 8
    66 000001F9 24F8                <1>     and al, 0xF8
    67 000001FB A2[A3010000]        <1>     mov [vga_col], al
    68 00000200 E8D2000000          <1>     call vga_update_cursor
    69 00000205 C3                  <1>     ret
    70                              <1> .store:
    71                              <1>     ; Character is in AL (via pushed EAX). Compute cell address from cursor.
    72 00000206 50                  <1>     push eax                        ; keep character byte safe
    73 00000207 0FB605[A2010000]    <1>     movzx eax, byte [vga_row]
    74 0000020E 0FB60D[A3010000]    <1>     movzx ecx, byte [vga_col]
    75 00000215 6BC050              <1>     imul eax, VGA_WIDTH
    76 00000218 01C8                <1>     add eax, ecx
    77 0000021A D1E0                <1>     shl eax, 1
    78 0000021C 0500800B00          <1>     add eax, VGA_ADDR
    79 00000221 89C7                <1>     mov edi, eax
    80 00000223 58                  <1>     pop eax                         ; EAX = character (low byte)
    81 00000224 B40F                <1>     mov ah, VGA_ATTR
    82 00000226 668907              <1>     mov word [edi], ax              ; write char + attribute
    83                              <1>     ; advance column, wrapping if needed
    84 00000229 A0[A3010000]        <1>     mov al, [vga_col]
    85 0000022E FEC0                <1>     inc al
    86 00000230 3C50                <1>     cmp al, VGA_WIDTH
    87 00000232 7206                <1>     jb .nowrap
    88 00000234 E80C000000          <1>     call vga_newline
    89 00000239 C3                  <1>     ret
    90                              <1> .nowrap:
    91 0000023A A2[A3010000]        <1>     mov [vga_col], al
    92 0000023F E893000000          <1>     call vga_update_cursor
    93 00000244 C3                  <1>     ret
    94                              <1> 
    95                              <1> ; -----------------------------------------------------------------------------
    96                              <1> vga_newline:
    97 00000245 60                  <1>     pusha
    98 00000246 C605[A3010000]00    <1>     mov byte [vga_col], 0
    99 0000024D A0[A2010000]        <1>     mov al, [vga_row]
   100 00000252 FEC0                <1>     inc al
   101 00000254 3C19                <1>     cmp al, VGA_HEIGHT
   102 00000256 7207                <1>     jb .no_scroll
   103 00000258 E80E000000          <1>     call vga_scroll
   104 0000025D B018                <1>     mov al, VGA_HEIGHT - 1
   105                              <1> .no_scroll:
   106 0000025F A2[A2010000]        <1>     mov [vga_row], al
   107 00000264 E86E000000          <1>     call vga_update_cursor
   108 00000269 61                  <1>     popa
   109 0000026A C3                  <1>     ret
   110                              <1> 
   111                              <1> ; -----------------------------------------------------------------------------
   112                              <1> vga_scroll:
   113 0000026B 60                  <1>     pusha
   114 0000026C BEA0800B00          <1>     mov esi, VGA_ADDR + VGA_WIDTH * 2
   115 00000271 BF00800B00          <1>     mov edi, VGA_ADDR
   116 00000276 B9C0030000          <1>     mov ecx, (VGA_WIDTH * (VGA_HEIGHT - 1) * 2) / 4
   117 0000027B F3A5                <1>     rep movsd
   118 0000027D BF008F0B00          <1>     mov edi, VGA_ADDR + VGA_WIDTH * (VGA_HEIGHT - 1) * 2
   119 00000282 66B8200F            <1>     mov ax, (VGA_ATTR << 8) | ' '
   120 00000286 B950000000          <1>     mov ecx, VGA_WIDTH
   121 0000028B 66F3AB              <1>     rep stosw
   122 0000028E 61                  <1>     popa
   123 0000028F C3                  <1>     ret
   124                              <1> 
   125                              <1> ; -----------------------------------------------------------------------------
   126                              <1> vga_print:
   127 00000290 60                  <1>     pusha
   128                              <1> .loop:
   129 00000291 AC                  <1>     lodsb
   130 00000292 84C0                <1>     test al, al
   131 00000294 7407                <1>     jz .done
   132 00000296 E836FFFFFF          <1>     call vga_putchar
   133 0000029B EBF4                <1>     jmp .loop
   134                              <1> .done:
   135 0000029D 61                  <1>     popa
   136 0000029E C3                  <1>     ret
   137                              <1> 
   138                              <1> ; -----------------------------------------------------------------------------
   139                              <1> vga_print_hex:
   140 0000029F 60                  <1>     pusha
   141 000002A0 B908000000          <1>     mov ecx, 8
   142 000002A5 89C3                <1>     mov ebx, eax
   143                              <1> .loop:
   144 000002A7 C1C304              <1>     rol ebx, 4
   145 000002AA 89D8                <1>     mov eax, ebx
   146 000002AC 83E00F              <1>     and eax, 0x0F
   147 000002AF 3C0A                <1>     cmp al, 10
   148 000002B1 7204                <1>     jb .digit
   149 000002B3 0437                <1>     add al, 'A' - 10
   150 000002B5 EB02                <1>     jmp .out
   151                              <1> .digit:
   152 000002B7 0430                <1>     add al, '0'
   153                              <1> .out:
   154 000002B9 E813FFFFFF          <1>     call vga_putchar
   155 000002BE 49                  <1>     dec ecx
   156 000002BF 75E6                <1>     jnz .loop
   157 000002C1 61                  <1>     popa
   158 000002C2 C3                  <1>     ret
   159                              <1> 
   160                              <1> ; -----------------------------------------------------------------------------
   161                              <1> vga_set_cursor:
   162 000002C3 50                  <1>     push eax
   163 000002C4 8835[A2010000]      <1>     mov [vga_row], dh
   164 000002CA 8815[A3010000]      <1>     mov [vga_col], dl
   165 000002D0 E802000000          <1>     call vga_update_cursor
   166 000002D5 58                  <1>     pop eax
   167 000002D6 C3                  <1>     ret
   168                              <1> 
   169                              <1> ; -----------------------------------------------------------------------------
   170                              <1> vga_update_cursor:
   171 000002D7 50                  <1>     push eax
   172 000002D8 52                  <1>     push edx
   173 000002D9 53                  <1>     push ebx
   174 000002DA 0FB605[A2010000]    <1>     movzx eax, byte [vga_row]
   175 000002E1 0FB60D[A3010000]    <1>     movzx ecx, byte [vga_col]
   176 000002E8 6BC050              <1>     imul eax, VGA_WIDTH
   177 000002EB 01C8                <1>     add eax, ecx                    ; EAX = linear cursor offset
   178 000002ED 6689C3              <1>     mov bx, ax                      ; stash position (BH=high, BL=low)
   179 000002F0 66BAD403            <1>     mov dx, 0x03D4
   180 000002F4 B00E                <1>     mov al, 0x0E
   181 000002F6 EE                  <1>     out dx, al
   182 000002F7 66BAD503            <1>     mov dx, 0x03D5
   183 000002FB 88F8                <1>     mov al, bh                      ; high byte
   184 000002FD EE                  <1>     out dx, al
   185 000002FE 66BAD403            <1>     mov dx, 0x03D4
   186 00000302 B00F                <1>     mov al, 0x0F
   187 00000304 EE                  <1>     out dx, al
   188 00000305 66BAD503            <1>     mov dx, 0x03D5
   189 00000309 88D8                <1>     mov al, bl                      ; low byte
   190 0000030B EE                  <1>     out dx, al
   191 0000030C 5B                  <1>     pop ebx
   192 0000030D 5A                  <1>     pop edx
   193 0000030E 58                  <1>     pop eax
   194 0000030F C3                  <1>     ret
   144                                  %include "src/kernel/serial.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Serial Port Logger (COM1, 115200 8N1)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; The serial logger is the single most important debugging tool in a kernel:
     5                              <1> ; it lets us trace interrupts, scheduler decisions, and crashes without the
     6                              <1> ; complications of VGA/vsync. QEMU exposes it with "-serial stdio" or a
     7                              <1> ; named pipe that can be opened in a terminal.
     8                              <1> ;
     9                              <1> ; Public interface:
    10                              <1> ;   serial_init       - configure COM1 to 115200 8N1
    11                              <1> ;   serial_putchar    - AL = byte to transmit
    12                              <1> ;   serial_write      - ESI = NUL-terminated string
    13                              <1> ;   serial_write_hex  - EAX = value, 8 hex digits
    14                              <1> ;   serial_newline    - CR + LF
    15                              <1> ; =============================================================================
    16                              <1> 
    17                              <1> SERIAL_PORT     equ 0x3F8        ; COM1 base
    18                              <1> 
    19                              <1> ; -----------------------------------------------------------------------------
    20                              <1> serial_init:
    21 00000310 50                  <1>     push eax
    22 00000311 52                  <1>     push edx
    23                              <1> 
    24 00000312 66BAF903            <1>     mov dx, SERIAL_PORT + 1
    25 00000316 B000                <1>     mov al, 0x00                ; disable interrupts
    26 00000318 EE                  <1>     out dx, al
    27                              <1> 
    28 00000319 66BAFB03            <1>     mov dx, SERIAL_PORT + 3
    29 0000031D B080                <1>     mov al, 0x80                ; enable DLAB
    30 0000031F EE                  <1>     out dx, al
    31                              <1> 
    32 00000320 66BAF803            <1>     mov dx, SERIAL_PORT + 0
    33 00000324 B001                <1>     mov al, 0x01                ; divisor low (115200 baud)
    34 00000326 EE                  <1>     out dx, al
    35 00000327 66BAF903            <1>     mov dx, SERIAL_PORT + 1
    36 0000032B B000                <1>     mov al, 0x00                ; divisor high
    37 0000032D EE                  <1>     out dx, al
    38                              <1> 
    39 0000032E 66BAFB03            <1>     mov dx, SERIAL_PORT + 3
    40 00000332 B003                <1>     mov al, 0x03                ; 8 data bits, no parity, 1 stop bit
    41 00000334 EE                  <1>     out dx, al
    42                              <1> 
    43 00000335 66BAFA03            <1>     mov dx, SERIAL_PORT + 2
    44 00000339 B0C7                <1>     mov al, 0xC7                ; enable FIFO, clear, 14-byte threshold
    45 0000033B EE                  <1>     out dx, al
    46                              <1> 
    47 0000033C 66BAFC03            <1>     mov dx, SERIAL_PORT + 4
    48 00000340 B00B                <1>     mov al, 0x0B                ; IRQ enable, RTS/DSR set
    49 00000342 EE                  <1>     out dx, al
    50                              <1> 
    51 00000343 5A                  <1>     pop edx
    52 00000344 58                  <1>     pop eax
    53 00000345 C3                  <1>     ret
    54                              <1> 
    55                              <1> ; -----------------------------------------------------------------------------
    56                              <1> serial_putchar:
    57 00000346 52                  <1>     push edx
    58 00000347 50                  <1>     push eax                    ; save the character (and clobber EAX freely)
    59 00000348 66BAFD03            <1>     mov dx, SERIAL_PORT + 5
    60                              <1> .wait:
    61 0000034C EC                  <1>     in al, dx
    62 0000034D A820                <1>     test al, 0x20              ; transmit holding register empty?
    63 0000034F 74FB                <1>     jz .wait
    64 00000351 66BAF803            <1>     mov dx, SERIAL_PORT + 0
    65 00000355 8B0424              <1>     mov eax, [esp]             ; reload saved character
    66 00000358 EE                  <1>     out dx, al
    67 00000359 58                  <1>     pop eax
    68 0000035A 5A                  <1>     pop edx
    69 0000035B C3                  <1>     ret
    70                              <1> 
    71                              <1> ; -----------------------------------------------------------------------------
    72                              <1> serial_write:
    73 0000035C 50                  <1>     push eax
    74 0000035D 56                  <1>     push esi
    75                              <1> .loop:
    76 0000035E AC                  <1>     lodsb
    77 0000035F 84C0                <1>     test al, al
    78 00000361 7407                <1>     jz .done
    79 00000363 E8DEFFFFFF          <1>     call serial_putchar
    80 00000368 EBF4                <1>     jmp .loop
    81                              <1> .done:
    82 0000036A 5E                  <1>     pop esi
    83 0000036B 58                  <1>     pop eax
    84 0000036C C3                  <1>     ret
    85                              <1> 
    86                              <1> ; -----------------------------------------------------------------------------
    87                              <1> serial_newline:
    88 0000036D 50                  <1>     push eax
    89 0000036E B00D                <1>     mov al, 0x0D
    90 00000370 E8D1FFFFFF          <1>     call serial_putchar
    91 00000375 B00A                <1>     mov al, 0x0A
    92 00000377 E8CAFFFFFF          <1>     call serial_putchar
    93 0000037C 58                  <1>     pop eax
    94 0000037D C3                  <1>     ret
    95                              <1> 
    96                              <1> ; -----------------------------------------------------------------------------
    97                              <1> serial_write_hex:
    98 0000037E 50                  <1>     push eax
    99 0000037F 51                  <1>     push ecx
   100 00000380 53                  <1>     push ebx
   101 00000381 B908000000          <1>     mov ecx, 8
   102 00000386 89C3                <1>     mov ebx, eax
   103                              <1> .loop:
   104 00000388 C1C304              <1>     rol ebx, 4
   105 0000038B 89D8                <1>     mov eax, ebx
   106 0000038D 83E00F              <1>     and eax, 0x0F
   107 00000390 3C0A                <1>     cmp al, 10
   108 00000392 7204                <1>     jb .digit
   109 00000394 0437                <1>     add al, 'A' - 10
   110 00000396 EB02                <1>     jmp .out
   111                              <1> .digit:
   112 00000398 0430                <1>     add al, '0'
   113                              <1> .out:
   114 0000039A E8A7FFFFFF          <1>     call serial_putchar
   115 0000039F 49                  <1>     dec ecx
   116 000003A0 75E6                <1>     jnz .loop
   117 000003A2 5B                  <1>     pop ebx
   118 000003A3 59                  <1>     pop ecx
   119 000003A4 58                  <1>     pop eax
   120 000003A5 C3                  <1>     ret
   145                                  %include "src/kernel/gdt.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Global Descriptor Table
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; The kernel replaces the Stage 2 loader's minimal GDT with a full one that
     5                              <1> ; includes ring-3 code/data segments and a Task State Segment. The layout:
     6                              <1> ;
     7                              <1> ;   selector   descriptor
     8                              <1> ;   0x00       null
     9                              <1> ;   0x08       kernel code (ring 0)
    10                              <1> ;   0x10       kernel data (ring 0)
    11                              <1> ;   0x18       user code   (ring 3, RPL 3 = 0x1B)
    12                              <1> ;   0x20       user data   (ring 3, RPL 3 = 0x23)
    13                              <1> ;   0x28       TSS
    14                              <1> ;
    15                              <1> ; Public interface:
    16                              <1> ;   gdt_install - load GDTR, reload segment registers, load the TSS
    17                              <1> ; =============================================================================
    18                              <1> 
    19                              <1> KERNEL_CS   equ 0x08
    20                              <1> KERNEL_DS   equ 0x10
    21                              <1> USER_CS     equ 0x18
    22                              <1> USER_DS     equ 0x20
    23                              <1> TSS_SELECTOR equ 0x28
    24                              <1> 
    25                              <1> ; -----------------------------------------------------------------------------
    26                              <1> ; gdt_install - install and activate the GDT and TSS.
    27                              <1> ; -----------------------------------------------------------------------------
    28                              <1> gdt_install:
    29 000003A6 50                  <1>     push eax
    30 000003A7 53                  <1>     push ebx
    31                              <1> 
    32                              <1>     ; Set the TSS ring-0 stack so the CPU knows where to put the stack when
    33                              <1>     ; it transitions from ring 3 to ring 0 (interrupts / syscalls).
    34 000003A8 C705[08040000]0000- <1>     mov dword [tss + 0x04], KERNEL_STACK_TOP   ; esp0
    34 000003B0 0900                <1>
    35 000003B2 C705[0C040000]1000- <1>     mov dword [tss + 0x08], KERNEL_DS          ; ss0
    35 000003BA 0000                <1>
    36                              <1> 
    37                              <1>     ; Fill the TSS descriptor's base address at runtime (NASM cannot apply
    38                              <1>     ; bitwise operators to a relocatable symbol).
    39 000003BC B8[04040000]        <1>     mov eax, tss
    40 000003C1 66A3[9A040000]      <1>     mov word [gdt + 0x28 + 2], ax      ; base bits 0-15
    41 000003C7 89C3                <1>     mov ebx, eax
    42 000003C9 C1EB10              <1>     shr ebx, 16
    43 000003CC 881D[9C040000]      <1>     mov byte [gdt + 0x28 + 4], bl      ; base bits 16-23
    44 000003D2 C1EB08              <1>     shr ebx, 8
    45 000003D5 881D[9F040000]      <1>     mov byte [gdt + 0x28 + 7], bl      ; base bits 24-31
    46                              <1> 
    47 000003DB 0F0115[A0040000]    <1>     lgdt [gdt_ptr]
    48                              <1> 
    49                              <1>     ; Reload data segment registers.
    50 000003E2 66B81000            <1>     mov ax, KERNEL_DS
    51 000003E6 8ED8                <1>     mov ds, ax
    52 000003E8 8EC0                <1>     mov es, ax
    53 000003EA 8EE0                <1>     mov fs, ax
    54 000003EC 8EE8                <1>     mov gs, ax
    55 000003EE 8ED0                <1>     mov ss, ax
    56                              <1> 
    57                              <1>     ; Reload CS via a far jump.
    58 000003F0 EA[F7030000]0800    <1>     jmp KERNEL_CS:.reload
    59                              <1> .reload:
    60                              <1>     ; Load the TSS.
    61 000003F7 66B82800            <1>     mov ax, TSS_SELECTOR
    62 000003FB 0F00D8              <1>     ltr ax
    63                              <1> 
    64 000003FE 5B                  <1>     pop ebx
    65 000003FF 58                  <1>     pop eax
    66 00000400 C3                  <1>     ret
    67                              <1> 
    68                              <1> ; -----------------------------------------------------------------------------
    69                              <1> ; Task State Segment (104 bytes for a 32-bit TSS). Defined before the GDT so
    70                              <1> ; its address is known when the TSS descriptor is assembled.
    71                              <1> ; -----------------------------------------------------------------------------
    72 00000401 90<rep 3h>          <1> align 4
    73                              <1> tss:
    74 00000404 00000000            <1>     dd 0            ; 0x00 prev task link
    75 00000408 00000000            <1>     dd 0            ; 0x04 esp0
    76 0000040C 00000000            <1>     dd 0            ; 0x08 ss0
    77 00000410 00000000            <1>     dd 0            ; 0x0C esp1
    78 00000414 00000000            <1>     dd 0            ; 0x10 ss1
    79 00000418 00000000            <1>     dd 0            ; 0x14 esp2
    80 0000041C 00000000            <1>     dd 0            ; 0x18 ss2
    81 00000420 00000000            <1>     dd 0            ; 0x1C cr3
    82 00000424 00000000            <1>     dd 0            ; 0x20 eip
    83 00000428 00000000            <1>     dd 0            ; 0x24 eflags
    84 0000042C 00000000            <1>     dd 0            ; 0x28 eax
    85 00000430 00000000            <1>     dd 0            ; 0x2C ecx
    86 00000434 00000000            <1>     dd 0            ; 0x30 edx
    87 00000438 00000000            <1>     dd 0            ; 0x34 ebx
    88 0000043C 00000000            <1>     dd 0            ; 0x38 esp
    89 00000440 00000000            <1>     dd 0            ; 0x3C ebp
    90 00000444 00000000            <1>     dd 0            ; 0x40 esi
    91 00000448 00000000            <1>     dd 0            ; 0x44 edi
    92 0000044C 00000000            <1>     dd 0            ; 0x48 es
    93 00000450 00000000            <1>     dd 0            ; 0x4C cs
    94 00000454 00000000            <1>     dd 0            ; 0x50 ss
    95 00000458 00000000            <1>     dd 0            ; 0x54 ds
    96 0000045C 00000000            <1>     dd 0            ; 0x58 fs
    97 00000460 00000000            <1>     dd 0            ; 0x5C gs
    98 00000464 00000000            <1>     dd 0            ; 0x60 ldt
    99 00000468 0000                <1>     dw 0            ; 0x64 trap flag / iomap base
   100 0000046A FFFF                <1>     dw 0xFFFF       ; 0x66 iomap base = 0xFFFF (no I/O bitmap)
   101                              <1> 
   102                              <1> ; -----------------------------------------------------------------------------
   103                              <1> ; GDT entries (flat 4 GiB model).
   104                              <1> ; -----------------------------------------------------------------------------
   105 0000046C 90<rep 4h>          <1> align 8
   106                              <1> gdt:
   107                              <1>     ; null
   108 00000470 0000000000000000    <1>     dq 0
   109                              <1>     ; 0x08 kernel code
   110 00000478 FFFF0000009ACF00    <1>     dw 0xFFFF, 0x0000, 0x9A00, 0x00CF
   111                              <1>     ; 0x10 kernel data
   112 00000480 FFFF00000092CF00    <1>     dw 0xFFFF, 0x0000, 0x9200, 0x00CF
   113                              <1>     ; 0x18 user code
   114 00000488 FFFF000000FACF00    <1>     dw 0xFFFF, 0x0000, 0xFA00, 0x00CF
   115                              <1>     ; 0x20 user data
   116 00000490 FFFF000000F2CF00    <1>     dw 0xFFFF, 0x0000, 0xF200, 0x00CF
   117                              <1>     ; 0x28 TSS (limit 0x67 = 103; base filled at runtime by gdt_install)
   118 00000498 6700                <1>     dw 0x0067
   119 0000049A 0000                <1>     dw 0
   120 0000049C 00                  <1>     db 0
   121 0000049D 89                  <1>     db 0x89                             ; present, 32-bit available TSS, DPL 0
   122 0000049E 40                  <1>     db 0x40
   123 0000049F 00                  <1>     db 0
   124                              <1> gdt_end:
   125                              <1> 
   126                              <1> gdt_ptr:
   127 000004A0 2F00                <1>     dw gdt_end - gdt - 1
   128 000004A2 [70040000]          <1>     dd gdt
   129                              <1> 
   146                                  %include "src/kernel/pic.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Programmable Interrupt Controller (8259 PIC)
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Remaps the two cascaded 8259 PICs so that hardware IRQs 0-15 map onto IDT
     5                              <1> ; vectors 32-47 (instead of colliding with CPU exception vectors 0-31).
     6                              <1> ;
     7                              <1> ; Public interface:
     8                              <1> ;   pic_remap      - remap master/slave to vectors 32/40
     9                              <1> ;   pic_send_eoi   - EAX = IRQ number (0-15); sends the proper EOI
    10                              <1> ;   pic_mask       - EAX = IRQ number; masks (disables) it
    11                              <1> ;   pic_unmask     - EAX = IRQ number; unmasks (enables) it
    12                              <1> ; =============================================================================
    13                              <1> 
    14                              <1> PIC1_COMMAND    equ 0x20
    15                              <1> PIC1_DATA       equ 0x21
    16                              <1> PIC2_COMMAND    equ 0xA0
    17                              <1> PIC2_DATA       equ 0xA1
    18                              <1> 
    19                              <1> PIC_EOI         equ 0x20
    20                              <1> ICW1_INIT       equ 0x11
    21                              <1> ICW4_8086       equ 0x01
    22                              <1> 
    23                              <1> ; -----------------------------------------------------------------------------
    24                              <1> pic_remap:
    25 000004A6 50                  <1>     push eax
    26 000004A7 52                  <1>     push edx
    27                              <1> 
    28                              <1>     ; Save existing masks.
    29 000004A8 E421                <1>     in al, PIC1_DATA
    30 000004AA A2[48050000]        <1>     mov [pic1_mask_saved], al
    31 000004AF E4A1                <1>     in al, PIC2_DATA
    32 000004B1 A2[49050000]        <1>     mov [pic2_mask_saved], al
    33                              <1> 
    34                              <1>     ; ICW1: start initialization sequence.
    35 000004B6 B011                <1>     mov al, ICW1_INIT
    36 000004B8 E620                <1>     out PIC1_COMMAND, al
    37 000004BA E6A0                <1>     out PIC2_COMMAND, al
    38                              <1> 
    39                              <1>     ; ICW2: vector offsets.
    40 000004BC B020                <1>     mov al, 0x20                ; master -> IDT 32
    41 000004BE E621                <1>     out PIC1_DATA, al
    42 000004C0 B028                <1>     mov al, 0x28                ; slave  -> IDT 40
    43 000004C2 E6A1                <1>     out PIC2_DATA, al
    44                              <1> 
    45                              <1>     ; ICW3: cascade wiring. Master IRQ2 -> slave; slave cascaded to IRQ2.
    46 000004C4 B004                <1>     mov al, 0x04
    47 000004C6 E621                <1>     out PIC1_DATA, al
    48 000004C8 B002                <1>     mov al, 0x02
    49 000004CA E6A1                <1>     out PIC2_DATA, al
    50                              <1> 
    51                              <1>     ; ICW4: 8086/88 mode.
    52 000004CC B001                <1>     mov al, ICW4_8086
    53 000004CE E621                <1>     out PIC1_DATA, al
    54 000004D0 E6A1                <1>     out PIC2_DATA, al
    55                              <1> 
    56                              <1>     ; Restore masks.
    57 000004D2 A0[48050000]        <1>     mov al, [pic1_mask_saved]
    58 000004D7 E621                <1>     out PIC1_DATA, al
    59 000004D9 A0[49050000]        <1>     mov al, [pic2_mask_saved]
    60 000004DE E6A1                <1>     out PIC2_DATA, al
    61                              <1> 
    62 000004E0 5A                  <1>     pop edx
    63 000004E1 58                  <1>     pop eax
    64 000004E2 C3                  <1>     ret
    65                              <1> 
    66                              <1> ; -----------------------------------------------------------------------------
    67                              <1> ; pic_send_eoi - EAX = IRQ number.
    68                              <1> ; -----------------------------------------------------------------------------
    69                              <1> pic_send_eoi:
    70 000004E3 50                  <1>     push eax
    71 000004E4 52                  <1>     push edx
    72 000004E5 83F808              <1>     cmp eax, 8
    73 000004E8 7204                <1>     jb .master
    74 000004EA B020                <1>     mov al, PIC_EOI
    75 000004EC E6A0                <1>     out PIC2_COMMAND, al        ; EOI to slave for IRQ 8-15
    76                              <1> .master:
    77 000004EE B020                <1>     mov al, PIC_EOI
    78 000004F0 E620                <1>     out PIC1_COMMAND, al
    79 000004F2 5A                  <1>     pop edx
    80 000004F3 58                  <1>     pop eax
    81 000004F4 C3                  <1>     ret
    82                              <1> 
    83                              <1> ; -----------------------------------------------------------------------------
    84                              <1> ; pic_mask - EAX = IRQ number (0-15).
    85                              <1> ; -----------------------------------------------------------------------------
    86                              <1> pic_mask:
    87 000004F5 50                  <1>     push eax
    88 000004F6 51                  <1>     push ecx
    89 000004F7 52                  <1>     push edx
    90 000004F8 89C1                <1>     mov ecx, eax
    91 000004FA BA21000000          <1>     mov edx, PIC1_DATA
    92 000004FF 83F908              <1>     cmp ecx, 8
    93 00000502 7208                <1>     jb .port_ok
    94 00000504 83E908              <1>     sub ecx, 8
    95 00000507 BAA1000000          <1>     mov edx, PIC2_DATA
    96                              <1> .port_ok:
    97 0000050C EC                  <1>     in al, dx
    98 0000050D B501                <1>     mov ch, 1
    99 0000050F D2E5                <1>     shl ch, cl
   100 00000511 08E8                <1>     or al, ch
   101 00000513 EE                  <1>     out dx, al
   102 00000514 5A                  <1>     pop edx
   103 00000515 59                  <1>     pop ecx
   104 00000516 58                  <1>     pop eax
   105 00000517 C3                  <1>     ret
   106                              <1> 
   107                              <1> ; -----------------------------------------------------------------------------
   108                              <1> ; pic_unmask - EAX = IRQ number (0-15).
   109                              <1> ; -----------------------------------------------------------------------------
   110                              <1> pic_unmask:
   111 00000518 50                  <1>     push eax
   112 00000519 51                  <1>     push ecx
   113 0000051A 52                  <1>     push edx
   114 0000051B 89C1                <1>     mov ecx, eax
   115 0000051D BA21000000          <1>     mov edx, PIC1_DATA
   116 00000522 83F908              <1>     cmp ecx, 8
   117 00000525 7208                <1>     jb .port_ok
   118 00000527 83E908              <1>     sub ecx, 8
   119 0000052A BAA1000000          <1>     mov edx, PIC2_DATA
   120                              <1> .port_ok:
   121 0000052F EC                  <1>     in al, dx
   122 00000530 B501                <1>     mov ch, 1
   123 00000532 D2E5                <1>     shl ch, cl
   124 00000534 F6D5                <1>     not ch
   125 00000536 20E8                <1>     and al, ch
   126 00000538 EE                  <1>     out dx, al
   127 00000539 5A                  <1>     pop edx
   128 0000053A 59                  <1>     pop ecx
   129 0000053B 58                  <1>     pop eax
   130 0000053C C3                  <1>     ret
   131                              <1> 
   132                              <1> ; -----------------------------------------------------------------------------
   133                              <1> ; pic_disable - mask every IRQ (used before disabling interrupts).
   134                              <1> ; -----------------------------------------------------------------------------
   135                              <1> pic_disable:
   136 0000053D 50                  <1>     push eax
   137 0000053E 52                  <1>     push edx
   138 0000053F B0FF                <1>     mov al, 0xFF
   139 00000541 E621                <1>     out PIC1_DATA, al
   140 00000543 E6A1                <1>     out PIC2_DATA, al
   141 00000545 5A                  <1>     pop edx
   142 00000546 58                  <1>     pop eax
   143 00000547 C3                  <1>     ret
   144                              <1> 
   145 00000548 00                  <1> pic1_mask_saved: db 0
   146 00000549 00                  <1> pic2_mask_saved: db 0
   147                                  %include "src/kernel/idt.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Interrupt Descriptor Table & ISR Stubs
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Installs an IDT covering CPU exceptions (0-31), remapped hardware IRQs
     5                              <1> ; (32-47), and the system-call gate (0x80). Every vector funnels through a
     6                              <1> ; common stub that builds a register frame on the stack, then dispatches.
     7                              <1> ;
     8                              <1> ; Register frame layout (offsets from the frame base pointer, which points at
     9                              <1> ; the pushed GS value):
    10                              <1> ;   REG_GS=0 REG_FS=4 REG_ES=8 REG_DS=12
    11                              <1> ;   REG_EDI=16 REG_ESI=20 REG_EBP=24 REG_ESP=28
    12                              <1> ;   REG_EBX=32 REG_EDX=36 REG_ECX=40 REG_EAX=44
    13                              <1> ;   REG_INTNUM=48 REG_ERR=52 REG_EIP=56 REG_CS=60 REG_EFLAGS=64
    14                              <1> ;
    15                              <1> ; Public interface:
    16                              <1> ;   idt_install      - fill the IDT, load IDTR
    17                              <1> ;   idt_set_gate     - EAX=vector, EBX=handler, CL=attributes
    18                              <1> ;   irq_register     - EAX=irq, EBX=handler; installs an IRQ handler
    19                              <1> ; =============================================================================
    20                              <1> 
    21                              <1> REG_GS       equ 0
    22                              <1> REG_FS       equ 4
    23                              <1> REG_ES       equ 8
    24                              <1> REG_DS       equ 12
    25                              <1> REG_EDI      equ 16
    26                              <1> REG_ESI      equ 20
    27                              <1> REG_EBP      equ 24
    28                              <1> REG_ESP      equ 28
    29                              <1> REG_EBX      equ 32
    30                              <1> REG_EDX      equ 36
    31                              <1> REG_ECX      equ 40
    32                              <1> REG_EAX      equ 44
    33                              <1> REG_INTNUM   equ 48
    34                              <1> REG_ERR      equ 52
    35                              <1> REG_EIP      equ 56
    36                              <1> REG_CS       equ 60
    37                              <1> REG_EFLAGS   equ 64
    38                              <1> 
    39                              <1> ; --- ISR stub macros -------------------------------------------------------
    40                              <1> %macro ISR_NOERR 1
    41                              <1> isr %+ %1:
    42                              <1>     push dword 0
    43                              <1>     push dword %1
    44                              <1>     jmp isr_common
    45                              <1> %endmacro
    46                              <1> 
    47                              <1> %macro ISR_ERR 1
    48                              <1> isr %+ %1:
    49                              <1>     push dword %1
    50                              <1>     jmp isr_common
    51                              <1> %endmacro
    52                              <1> 
    53                              <1> ; --- Instantiate exception stubs (0-31) ------------------------------------
    54                              <1> ISR_NOERR 0
    41                              <2> isr %+ %1:
    42 0000054A 6A00                <2>  push dword 0
    43 0000054C 6A00                <2>  push dword %1
    44 0000054E E9DF020000          <2>  jmp isr_common
    55                              <1> ISR_NOERR 1
    41                              <2> isr %+ %1:
    42 00000553 6A00                <2>  push dword 0
    43 00000555 6A01                <2>  push dword %1
    44 00000557 E9D6020000          <2>  jmp isr_common
    56                              <1> ISR_NOERR 2
    41                              <2> isr %+ %1:
    42 0000055C 6A00                <2>  push dword 0
    43 0000055E 6A02                <2>  push dword %1
    44 00000560 E9CD020000          <2>  jmp isr_common
    57                              <1> ISR_NOERR 3
    41                              <2> isr %+ %1:
    42 00000565 6A00                <2>  push dword 0
    43 00000567 6A03                <2>  push dword %1
    44 00000569 E9C4020000          <2>  jmp isr_common
    58                              <1> ISR_NOERR 4
    41                              <2> isr %+ %1:
    42 0000056E 6A00                <2>  push dword 0
    43 00000570 6A04                <2>  push dword %1
    44 00000572 E9BB020000          <2>  jmp isr_common
    59                              <1> ISR_NOERR 5
    41                              <2> isr %+ %1:
    42 00000577 6A00                <2>  push dword 0
    43 00000579 6A05                <2>  push dword %1
    44 0000057B E9B2020000          <2>  jmp isr_common
    60                              <1> ISR_NOERR 6
    41                              <2> isr %+ %1:
    42 00000580 6A00                <2>  push dword 0
    43 00000582 6A06                <2>  push dword %1
    44 00000584 E9A9020000          <2>  jmp isr_common
    61                              <1> ISR_NOERR 7
    41                              <2> isr %+ %1:
    42 00000589 6A00                <2>  push dword 0
    43 0000058B 6A07                <2>  push dword %1
    44 0000058D E9A0020000          <2>  jmp isr_common
    62                              <1> ISR_ERR   8
    48                              <2> isr %+ %1:
    49 00000592 6A08                <2>  push dword %1
    50 00000594 E999020000          <2>  jmp isr_common
    63                              <1> ISR_NOERR 9
    41                              <2> isr %+ %1:
    42 00000599 6A00                <2>  push dword 0
    43 0000059B 6A09                <2>  push dword %1
    44 0000059D E990020000          <2>  jmp isr_common
    64                              <1> ISR_ERR   10
    48                              <2> isr %+ %1:
    49 000005A2 6A0A                <2>  push dword %1
    50 000005A4 E989020000          <2>  jmp isr_common
    65                              <1> ISR_ERR   11
    48                              <2> isr %+ %1:
    49 000005A9 6A0B                <2>  push dword %1
    50 000005AB E982020000          <2>  jmp isr_common
    66                              <1> ISR_ERR   12
    48                              <2> isr %+ %1:
    49 000005B0 6A0C                <2>  push dword %1
    50 000005B2 E97B020000          <2>  jmp isr_common
    67                              <1> ISR_ERR   13
    48                              <2> isr %+ %1:
    49 000005B7 6A0D                <2>  push dword %1
    50 000005B9 E974020000          <2>  jmp isr_common
    68                              <1> ISR_ERR   14
    48                              <2> isr %+ %1:
    49 000005BE 6A0E                <2>  push dword %1
    50 000005C0 E96D020000          <2>  jmp isr_common
    69                              <1> ISR_NOERR 15
    41                              <2> isr %+ %1:
    42 000005C5 6A00                <2>  push dword 0
    43 000005C7 6A0F                <2>  push dword %1
    44 000005C9 E964020000          <2>  jmp isr_common
    70                              <1> ISR_NOERR 16
