   133 00001A63 C7402000000000      <1>     mov dword [eax + 32], 0             ; ebx
   134 00001A6A C7402400000000      <1>     mov dword [eax + 36], 0             ; edx
   135 00001A71 C7402800000000      <1>     mov dword [eax + 40], 0             ; ecx
