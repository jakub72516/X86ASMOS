   178                              <1> ; -----------------------------------------------------------------------------
   179                              <1> ; task_sleep - EAX = number of ticks to sleep. Preserves all other registers.
   180                              <1> ; -----------------------------------------------------------------------------
   181                              <1> task_sleep:
   182 00001ADF 60                  <1>     pusha
   183 00001AE0 FA                  <1>     cli
   184 00001AE1 8B0D[85190000]      <1>     mov ecx, [current_task]
   185 00001AE7 8B1D[89190000]      <1>     mov ebx, [tick_count]
   186 00001AED 01C3                <1>     add ebx, eax
   187 00001AEF 89590C              <1>     mov [ecx + TCB_SLEEP], ebx
   188 00001AF2 C7410801000000      <1>     mov dword [ecx + TCB_STATE], TASK_STATE_SLEEPING
