   154                                  %include "src/sched/task.asm"
     1                              <1> ; =============================================================================
     2                              <1> ; X86ASMOS - Multitasking Scheduler & Tasks
     3                              <1> ; -----------------------------------------------------------------------------
     4                              <1> ; Pre-emptive round-robin scheduler driven by the PIT (IRQ0). Tasks are kernel
     5                              <1> ; threads running in ring 0 on their own private kernel stacks.
     6                              <1> ;
     7                              <1> ; Context switching is interrupt-driven and lean: the CPU and isr_common save
     8                              <1> ; a task's full register state as a 68-byte "frame" on its stack, so the
     9                              <1> ; scheduler only needs to swap the stack pointer (ESP) and let the shared
    10                              <1> ; isr_restore epilogue `iret` into the next task.
    11                              <1> ;
    12                              <1> ; Task frame layout (offsets from the frame base, matching idt.asm):
    13                              <1> ;   +0 gs +4 fs +8 es +12 ds +16 edi +20 esi +24 ebp +28 esp
    14                              <1> ;   +32 ebx +36 edx +40 ecx +44 eax +48 intnum +52 err
    15                              <1> ;   +56 eip +60 cs +64 eflags
    16                              <1> ;
    17                              <1> ; TCB layout:
    18                              <1> ;   +0  esp        kernel stack pointer (frame base)
    19                              <1> ;   +4  next       next TCB in the circular run queue
    20                              <1> ;   +8  state      0 = ready, 1 = sleeping, 2 = zombie
    21                              <1> ;   +12 sleep_until tick at which a sleeping task wakes (0 = awake)
    22                              <1> ;   +16 pid
    23                              <1> ;   +20 stack      base address of the task's stack (for freeing)
    24                              <1> ;   +24 msg_head   head of the task's IPC message queue (mailbox)
    25                              <1> ;
    26                              <1> ; Public interface:
    27                              <1> ;   scheduler_init - set up the boot task as the initial run queue
    28                              <1> ;   task_create    - EBX=entry, ECX=arg, EDX=name; returns EAX=pid
    29                              <1> ;   task_yield     - voluntarily yield the CPU (int 0x81)
    30                              <1> ;   task_sleep     - EAX=ticks; sleep for that many ticks
    31                              <1> ;   task_exit      - terminate the current task
    32                              <1> ;   timer_handler  - IRQ0 handler (EOI + tick + switch)
    33                              <1> ;   yield_handler  - int 0x81 handler (switch)
    34                              <1> ;   ipc_send       - EAX=pid, EBX=message value; enqueue a message
    35                              <1> ;   ipc_recv       - EAX = next message (blocking), 0xFFFFFFFF if none
    36                              <1> ; =============================================================================
    37                              <1> 
    38                              <1> TASK_STATE_READY    equ 0
    39                              <1> TASK_STATE_SLEEPING equ 1
    40                              <1> TASK_STATE_ZOMBIE   equ 2
    41                              <1> 
    42                              <1> TCB_ESP        equ 0
    43                              <1> TCB_NEXT       equ 4
    44                              <1> TCB_STATE      equ 8
    45                              <1> TCB_SLEEP      equ 12
    46                              <1> TCB_PID        equ 16
    47                              <1> TCB_STACK      equ 20
    48                              <1> TCB_MSG_HEAD   equ 24
    49                              <1> TCB_SIZE       equ 28
    50                              <1> 
    51                              <1> TASK_STACK_SIZE equ 8192                ; 8 KiB per kernel thread
    52                              <1> FRAME_SIZE     equ 68
    53                              <1> 
    54 00001985 00000000            <1> current_task:  dd 0
    55 00001989 00000000            <1> tick_count:    dd 0
    56 0000198D 01000000            <1> next_pid:      dd 1
    57                              <1> 
    58                              <1> ; -----------------------------------------------------------------------------
    59                              <1> ; scheduler_init - create the TCB for the boot thread and make it current.
    60                              <1> ; -----------------------------------------------------------------------------
    61                              <1> scheduler_init:
    62 00001991 60                  <1>     pusha
    63                              <1>     ; Allocate a TCB for the boot thread.
    64 00001992 B81C000000          <1>     mov eax, TCB_SIZE
    65 00001997 E80FFBFFFF          <1>     call kmalloc
    66 0000199C A3[85190000]        <1>     mov [current_task], eax
    67 000019A1 89C3                <1>     mov ebx, eax
    68 000019A3 C70300000000        <1>     mov dword [ebx + TCB_ESP], 0        ; set on first context switch
    69 000019A9 895B04              <1>     mov dword [ebx + TCB_NEXT], ebx     ; self (circular)
    70 000019AC C7430800000000      <1>     mov dword [ebx + TCB_STATE], TASK_STATE_READY
    71 000019B3 C7430C00000000      <1>     mov dword [ebx + TCB_SLEEP], 0
    72 000019BA C7431000000000      <1>     mov dword [ebx + TCB_PID], 0
    73 000019C1 C7431400000000      <1>     mov dword [ebx + TCB_STACK], 0
    74 000019C8 C7431800000000      <1>     mov dword [ebx + TCB_MSG_HEAD], 0
    75 000019CF C705[8D190000]0100- <1>     mov dword [next_pid], 1
    75 000019D7 0000                <1>
    76 000019D9 C705[89190000]0000- <1>     mov dword [tick_count], 0
    76 000019E1 0000                <1>
    77 000019E3 61                  <1>     popa
    78 000019E4 C3                  <1>     ret
    79                              <1> 
    80                              <1> ; -----------------------------------------------------------------------------
    81                              <1> ; task_create - EBX=entry, ECX=arg, EDX=name (unused for now).
    82                              <1> ; Returns EAX = pid.
    83                              <1> ; -----------------------------------------------------------------------------
    84                              <1> task_create:
    85 000019E5 53                  <1>     push ebx
    86 000019E6 51                  <1>     push ecx
    87 000019E7 52                  <1>     push edx
    88 000019E8 56                  <1>     push esi
    89 000019E9 57                  <1>     push edi
    90                              <1> 
    91                              <1>     ; Allocate a stack (8 KiB).
    92 000019EA 53                  <1>     push ebx
    93 000019EB 51                  <1>     push ecx
    94 000019EC 52                  <1>     push edx
    95 000019ED B800200000          <1>     mov eax, TASK_STACK_SIZE
    96 000019F2 E8B4FAFFFF          <1>     call kmalloc
    97 000019F7 89C7                <1>     mov edi, eax                        ; EDI = stack base
    98 000019F9 5A                  <1>     pop edx
    99 000019FA 59                  <1>     pop ecx
   100 000019FB 5B                  <1>     pop ebx
   101 000019FC 85FF                <1>     test edi, edi
   102 000019FE 0F84D0000000        <1>     jz .fail
   103                              <1> 
   104                              <1>     ; Allocate a TCB.
   105 00001A04 53                  <1>     push ebx
   106 00001A05 51                  <1>     push ecx
   107 00001A06 52                  <1>     push edx
   108 00001A07 57                  <1>     push edi
   109 00001A08 B81C000000          <1>     mov eax, TCB_SIZE
   110 00001A0D E899FAFFFF          <1>     call kmalloc
   111 00001A12 89C6                <1>     mov esi, eax                        ; ESI = TCB
   112 00001A14 5F                  <1>     pop edi
   113 00001A15 5A                  <1>     pop edx
   114 00001A16 59                  <1>     pop ecx
   115 00001A17 5B                  <1>     pop ebx
   116 00001A18 85F6                <1>     test esi, esi
   117 00001A1A 0F84B4000000        <1>     jz .fail
   118                              <1> 
   119                              <1>     ; Build the initial frame at the top of the stack.
   120 00001A20 89F8                <1>     mov eax, edi
   121 00001A22 0500200000          <1>     add eax, TASK_STACK_SIZE            ; stack top
   122 00001A27 83E844              <1>     sub eax, FRAME_SIZE                 ; frame base
   123 00001A2A 8906                <1>     mov [esi + TCB_ESP], eax
   124                              <1> 
   125 00001A2C C70010000000        <1>     mov dword [eax + 0], KERNEL_DS      ; gs
   126 00001A32 C7400410000000      <1>     mov dword [eax + 4], KERNEL_DS      ; fs
   127 00001A39 C7400810000000      <1>     mov dword [eax + 8], KERNEL_DS      ; es
   128 00001A40 C7400C10000000      <1>     mov dword [eax + 12], KERNEL_DS     ; ds
   129 00001A47 C7401000000000      <1>     mov dword [eax + 16], 0             ; edi
   130 00001A4E C7401400000000      <1>     mov dword [eax + 20], 0             ; esi
   131 00001A55 C7401800000000      <1>     mov dword [eax + 24], 0             ; ebp
